  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport {\n  generateGeoGrid,\n  type GridResult,\n  type GridPoint,\n  type DistanceUnit,\n} from \'./engine/geoGrid.ts\';\nimport {\n  parseLocalSerpRank,\n  MOCK_LOCAL_SERP_ITEMS,\n  type PinScanResult,\n  type SerpLocalItem,\n} from \'./engine/serpParser.ts\';\nimport {\n  LocalSeoAuditPitchSchema,\n  buildLocalSeoAuditPrompt,\n  SAMPLE_AUDIT_PITCH_JSON,\n  type LocalSeoAuditPitchOutput,\n  type LocalSeoAuditPitchInput,\n} from \'./engine/aiAuditPitch.ts\';\nimport { runAllEngineTests, type TestResult } from \'./engine/engineTests.ts\';\nimport {\n  MapPin,\n  Grid,\n  Search,\n  Sparkles,\n  CheckCircle2,\n  XCircle,\n  Copy,\n  Check,\n  RefreshCw,\n  TrendingDown,\n  Mail,\n  ShieldCheck,\n  FileCode2,\n  ChevronRight,\n  ExternalLink,\n  Layers,\n  BarChart3,\n  DollarSign,\n  AlertTriangle,\n} from \'lucide-react\';\n\n// Location presets for instant testing\nconst PRESETS = [\n  { name: \'Austin, TX (Downtown)\', lat: 30.2672, lng: -97.7431, category: \'Plumber\' },\n  { name: \'Miami, FL (Brickell)\', lat: 25.7617, lng: -80.1918, category: \'Cosmetic Dentist\' },\n  { name: \'Los Angeles, CA (Santa Monica)\', lat: 34.0195, lng: -118.4912, category: \'Personal Injury Lawyer\' },\n  { name: \'Chicago, IL (Loop)\', lat: 41.8781, lng: -87.6298, category: \'HVAC Contractor\' },\n];\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\'grid\' | \'parser\' | \'audit\' | \'tests\' | \'code\'>(\'grid\');\n\n  // ==========================================\n  // 1. Grid Generator State\n  // ==========================================\n  const [centerLat, setCenterLat] = useState<number>(30.2672);\n  const [centerLng, setCenterLng] = useState<number>(-97.7431);\n  const [gridSize, setGridSize] = useState<number>(5);\n  const [distanceStep, setDistanceStep] = useState<number>(1.0);\n  const [unit, setUnit] = useState<DistanceUnit>(\'km\');\n  const [gridResult, setGridResult] = useState<GridResult>(() =>\n    generateGeoGrid({ center: { lat: 30.2672, lng: -97.7431 }, gridSize: 5, distanceStep: 1.0, unit: \'km\' })\n  );\n  const [selectedPoint, setSelectedPoint] = useState<GridPoint | null>(null);\n\n  // Recalculate grid whenever inputs change\n  useEffect(() => {\n    try {\n      const res = generateGeoGrid({\n        center: { lat: centerLat, lng: centerLng },\n        gridSize,\n        distanceStep,\n        unit,\n      });\n      setGridResult(res);\n      // Select center point by default\n      const center = res.points.find((p) => p.isCenter) || res.points[0];\n      setSelectedPoint(center);\n    } catch (e) {\n      console.error(\'Grid generation error:\', e);\n    }\n  }, [centerLat, centerLng, gridSize, distanceStep, unit]);\n\n  // ==========================================\n  // 2. SERP Parser State\n  // ==========================================\n  const [targetType, setTargetType] = useState<\'name\' | \'domain\' | \'placeId\'>(\'name\');\n  const [queryName, setQueryName] = useState<string>(\'Apex Emergency Plumbing Austin\');\n  const [queryDomain, setQueryDomain] = useState<string>(\'apexplumbingaustin.com\');\n  const [queryPlaceId, setQueryPlaceId] = useState<string>(\'ChIJ_apex_plumbing_01\');\n  const [scanResult, setScanResult] = useState<PinScanResult>(() =>\n    parseLocalSerpRank({ businessName: \'Apex Emergency Plumbing Austin\' }, MOCK_LOCAL_SERP_ITEMS)\n  );\n\n  const handleRunParser = () => {\n    let target = {};\n    if (targetType === \'name\') target = { businessName: queryName };\n    else if (targetType === \'domain\') target = { domainOrUrl: queryDomain };\n    else if (targetType === \'placeId\') target = { placeId: queryPlaceId };\n\n    const res = parseLocalSerpRank(target, MOCK_LOCAL_SERP_ITEMS);\n    setScanResult(res);\n  };\n\n  // ==========================================\n  // 3. AI Audit & Pitch State\n  // ==========================================\n  const [auditBusinessName, setAuditBusinessName] = useState<string>(\'Austin Premier Plumbing\');\n  const [auditCategory, setAuditCategory] = useState<string>(\'Emergency Plumber\');\n  const [targetMarket, setTargetMarket] = useState<string>(\'Austin, TX\');\n  const [avgRank, setAvgRank] = useState<number>(11.4);\n  const [top3Pct, setTop3Pct] = useState<number>(16.0);\n  const [totalNodes, setTotalNodes] = useState<number>(25);\n  const [isGeneratingAudit, setIsGeneratingAudit] = useState<boolean>(false);\n  const [auditOutput, setAuditOutput] = useState<LocalSeoAuditPitchOutput>(SAMPLE_AUDIT_PITCH_JSON);\n  const [generationSource, setGenerationSource] = useState<string>(\'Sample Data\');\n  const [copiedSection, setCopiedSection] = useState<string | null>(null);\n\n  const handleGenerateAudit = async () => {\n    setIsGeneratingAudit(true);\n    const input: LocalSeoAuditPitchInput = {\n      businessName: auditBusinessName,\n      category: auditCategory,\n      metrics: {\n        averageRank: Number(avgRank),\n        top3Percentage: Number(top3Pct),\n        totalNodesScanned: Number(totalNodes),\n        gridSpanDescription: `${gridSize}x${gridSize} grid across ${distanceStep * gridSize} ${unit} coverage`,\n        targetMarket,\n      },\n      topCompetitorsInWeakZones: [\n        { name: \'Apex Emergency Plumbing Austin\', rating: 4.9, reviews: 342, category: \'Plumber\' },\n        { name: \'Capital City Water Heaters\', rating: 4.8, reviews: 215, category: \'Plumber\' },\n        { name: \'Lone Star Rooter Pros\', rating: 4.7, reviews: 189, category: \'Plumbing Service\' },\n      ],\n    };\n\n    try {\n      const resp = await fetch(\'/api/generate-audit-pitch\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(input),\n      });\n      const data = await resp.json();\n      if (data.success && data.data) {\n        setAuditOutput(data.data);\n        setGenerationSource(data.source === \'gemini-3.8-flash\' ? \'Gemini 3.8 Flash\' : \'Deterministic Engine\');\n      } else {\n        throw new Error(data.error || \'Server error\');\n      }\n    } catch (err) {\n      console.warn(\'API error, using client-side deterministic generator:\', err);\n      // Fallback directly\n      const fallback = SAMPLE_AUDIT_PITCH_JSON;\n      setAuditOutput(fallback);\n      setGenerationSource(\'Client Fallback\');\n    } finally {\n      setIsGeneratingAudit(false);\n    }\n  };\n\n  // ==========================================\n  // 4. Automated Tests State\n  // ==========================================\n  const [testResults, setTestResults] = useState<{\n    allPassed: boolean;\n    totalTests: number;\n    passCount: number;\n    failCount: number;\n    results: TestResult[];\n  }>(() => runAllEngineTests());\n\n  const handleRerunTests = () => {\n    const results = runAllEngineTests();\n    setTestResults(results);\n  };\n\n  const copyToClipboard = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedSection(id);\n    setTimeout(() => setCopiedSection(null), 2000);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans antialiased selection:bg-indigo-500/30 selection:text-indigo-200\">\n      {/* Top Header */}\n      <header className=\"border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-emerald-400 p-0.5 flex items-center justify-center shadow-lg shadow-indigo-500/20\">\n              <div className=\"w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center\">\n                <MapPin className=\"w-5 h-5 text-emerald-400\" />\n              </div>\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-lg tracking-tight text-white\">GeoRank Pro</span>\n                <span className=\"px-2 py-0.5 text-[11px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-full\">\n                  Core Engine Prototype\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 hidden sm:block\">\n                Local SEO Geo-Grid Rank Tracker & Prospecting Engine\n              </p>\n            </div>\n          </div>\n\n          {/* Navigation Tabs */}\n          <nav className=\"flex space-x-1 sm:space-x-2 bg-slate-950/80 p-1 rounded-xl border border-slate-800\">\n            <button\n              onClick={() => setActiveTab(\'grid\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${\n                activeTab === \'grid\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n              }`}\n            >\n              <Grid className=\"w-3.5 h-3.5\" />\n              <span>1. Geo-Grid Math</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'parser\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${\n                activeTab === \'parser\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n              }`}\n            >\n              <Search className=\"w-3.5 h-3.5\" />\n              <span>2. SERP Parser</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'audit\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${\n                activeTab === \'audit\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-300\" />\n              <span>3. AI Audit & Pitch</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'tests\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${\n                activeTab === \'tests\'\n                  ? \'bg-emerald-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n              }`}\n            >\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden md:inline\">Automated Tests</span>\n              <span className=\"md:hidden\">Tests</span>\n              <span className=\"ml-1 px-1.5 py-0.2 bg-emerald-500/20 text-emerald-300 rounded text-[10px]\">\n                {testResults.passCount}/{testResults.totalTests}\n              </span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'code\')}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${\n                activeTab === \'code\'\n                  ? \'bg-slate-800 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900\'\n              }`}\n            >\n              <FileCode2 className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">TypeScript Code</span>\n              <span className=\"sm:hidden\">Code</span>\n            </button>\n          </nav>\n        </div>\n      </header>\n\n      {/* Main Container */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6\">\n\n        {/* ========================================================= */}\n        {/* TAB 1: COORDINATE GRID GENERATOR                           */}\n        {/* ========================================================= */}\n        {activeTab === \'grid\' && (\n          <div className=\"space-y-6\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80\">\n              <div>\n                <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                  <Grid className=\"w-5 h-5 text-indigo-400\" />\n                  Item 1: Geodesic Coordinate Grid Generator\n                </h1>\n                <p className=\"text-sm text-slate-400 mt-1 max-w-2xl\">\n                  Calculates an equidistant N\303\227N geographic matrix accounting for meridional convergence,\n                  curvature scaling, and geodesic offset mathematics.\n                </p>\n              </div>\n\n              {/* Quick Presets */}\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <span className=\"text-xs text-slate-500 font-medium\">Presets:</span>\n                {PRESETS.map((p) => (\n                  <button\n                    key={p.name}\n                    onClick={() => {\n                      setCenterLat(p.lat);\n                      setCenterLng(p.lng);\n                    }}\n                    className=\"text-xs px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 transition\"\n                  >\n                    {p.name.split(\' \')[0]}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Grid Controls & Visual Radar */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              {/* Left Config Panel */}\n              <div className=\"lg:col-span-4 bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                <h2 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                  Grid Parameters\n                </h2>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">Center Latitude</label>\n                    <input\n                      type=\"number\"\n                      step=\"0.0001\"\n                      value={centerLat}\n                      onChange={(e) => setCenterLat(parseFloat(e.target.value) || 0)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">Center Longitude</label>\n                    <input\n                      type=\"number\"\n                      step=\"0.0001\"\n                      value={centerLng}\n                      onChange={(e) => setCenterLng(parseFloat(e.target.value) || 0)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Grid Dimension</label>\n                      <select\n                        value={gridSize}\n                        onChange={(e) => setGridSize(parseInt(e.target.value))}\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500\"\n                      >\n                        <option value={3}>3x3 (9 pins)</option>\n                        <option value={5}>5x5 (25 pins)</option>\n                        <option value={7}>7x7 (49 pins)</option>\n                        <option value={9}>9x9 (81 pins)</option>\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Unit</label>\n                      <div className=\"grid grid-cols-2 gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800\">\n                        <button\n                          onClick={() => setUnit(\'km\')}\n                          className={`py-1 text-xs rounded font-medium ${\n                            unit === \'km\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n                          }`}\n                        >\n                          km\n                        </button>\n                        <button\n                          onClick={() => setUnit(\'mi\')}\n                          className={`py-1 text-xs rounded font-medium ${\n                            unit === \'mi\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n                          }`}\n                        >\n                          miles\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div>\n                    <div className=\"flex justify-between items-center mb-1\">\n                      <label className=\"text-xs text-slate-400\">\n                        Distance Step: <span className=\"font-semibold text-indigo-400\">{distanceStep} {unit}</span>\n                      </label>\n                      <span className=\"text-[11px] text-slate-500\">\n                        Span: {(distanceStep * (gridSize - 1)).toFixed(1)} {unit}\n                      </span>\n                    </div>\n                    <input\n                      type=\"range\"\n                      min=\"0.2\"\n                      max=\"10.0\"\n                      step=\"0.2\"\n                      value={distanceStep}\n                      onChange={(e) => setDistanceStep(parseFloat(e.target.value))}\n                      className=\"w-full accent-indigo-500 cursor-pointer\"\n                    />\n                    <div className=\"flex justify-between text-[10px] text-slate-600 mt-0.5\">\n                      <span>0.2 {unit} (Dense)</span>\n                      <span>5.0 {unit}</span>\n                      <span>10.0 {unit} (Metro)</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Spatial Extents Summary */}\n                <div className=\"pt-3 border-t border-slate-800 space-y-2\">\n                  <div className=\"text-xs text-slate-400 font-medium\">Calculated Bounding Box:</div>\n                  <div className=\"grid grid-cols-2 gap-2 text-xs font-mono\">\n                    <div className=\"bg-slate-950 p-2 rounded border border-slate-850\">\n                      <span className=\"text-slate-500 block text-[10px]\">North Lat</span>\n                      <span className=\"text-emerald-400\">{gridResult.bounds.north}</span>\n                    </div>\n                    <div className=\"bg-slate-950 p-2 rounded border border-slate-850\">\n                      <span className=\"text-slate-500 block text-[10px]\">South Lat</span>\n                      <span className=\"text-emerald-400\">{gridResult.bounds.south}</span>\n                    </div>\n                    <div className=\"bg-slate-950 p-2 rounded border border-slate-850\">\n                      <span className=\"text-slate-500 block text-[10px]\">East Lng</span>\n                      <span className=\"text-indigo-400\">{gridResult.bounds.east}</span>\n                    </div>\n                    <div className=\"bg-slate-950 p-2 rounded border border-slate-850\">\n                      <span className=\"text-slate-500 block text-[10px]\">West Lng</span>\n                      <span className=\"text-indigo-400\">{gridResult.bounds.west}</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Center Interactive Geo-Grid Canvas */}\n              <div className=\"lg:col-span-8 bg-slate-900 p-5 rounded-2xl border border-slate-800 flex flex-col\">\n                <div className=\"flex items-center justify-between mb-4\">\n                  <div className=\"flex items-center space-x-2\">\n                    <h2 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                      Interactive Visual Geo-Grid Map\n                    </h2>\n                    <span className=\"text-xs px-2 py-0.5 bg-slate-800 text-slate-300 rounded-full font-mono\">\n                      {gridResult.totalPoints} Nodes\n                    </span>\n                  </div>\n                  <div className=\"text-xs text-slate-500\">\n                    Click any pin to inspect coordinate offsets\n                  </div>\n                </div>\n\n                {/* Grid Visualizer */}\n                <div className=\"flex-1 bg-slate-950 rounded-xl border border-slate-800/80 p-6 flex items-center justify-center relative overflow-hidden min-h-[380px]\">\n                  {/* Radar Circles */}\n                  <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">\n                    <div className=\"w-80 h-80 rounded-full border border-indigo-500\"></div>\n                    <div className=\"w-56 h-56 rounded-full border border-indigo-500/80\"></div>\n                    <div className=\"w-32 h-32 rounded-full border border-indigo-500/60\"></div>\n                    <div className=\"w-full h-[1px] bg-indigo-500/30\"></div>\n                    <div className=\"h-full w-[1px] bg-indigo-500/30\"></div>\n                  </div>\n\n                  {/* Cardinal Direction Indicators */}\n                  <span className=\"absolute top-2 font-mono text-[11px] text-slate-500 tracking-widest font-bold\">NORTH (0\302\260)</span>\n                  <span className=\"absolute bottom-2 font-mono text-[11px] text-slate-500 tracking-widest font-bold\">SOUTH (180\302\260)</span>\n                  <span className=\"absolute right-3 font-mono text-[11px] text-slate-500 tracking-widest font-bold\">EAST (90\302\260)</span>\n                  <span className=\"absolute left-3 font-mono text-[11px] text-slate-500 tracking-widest font-bold\">WEST (270\302\260)</span>\n\n                  {/* Grid Points Render */}\n                  <div\n                    className=\"grid gap-3 relative z-10\"\n                    style={{\n                      gridTemplateColumns: `repeat(${gridSize}, minmax(0, 1fr))`,\n                    }}\n                  >\n                    {gridResult.points.map((point) => {\n                      const isSelected = selectedPoint?.id === point.id;\n                      return (\n                        <button\n                          key={point.id}\n                          onClick={() => setSelectedPoint(point)}\n                          className={`group relative w-11 h-11 rounded-xl flex flex-col items-center justify-center transition-all duration-150 transform hover:scale-110 ${\n                            point.isCenter\n                              ? \'bg-emerald-500 text-slate-950 font-bold shadow-lg shadow-emerald-500/30 ring-2 ring-emerald-300\'\n                              : isSelected\n                              ? \'bg-indigo-500 text-white shadow-lg shadow-indigo-500/30 ring-2 ring-indigo-300\'\n                              : \'bg-slate-800/90 hover:bg-slate-700 text-slate-300 border border-slate-700\'\n                          }`}\n                        >\n                          <span className=\"text-[10px] font-mono leading-none\">\n                            {point.rowIndex},{point.colIndex}\n                          </span>\n                          <span className=\"text-[9px] opacity-75 font-mono\">\n                            {point.isCenter ? \'Center\' : `${point.distanceFromCenter}${unit}`}\n                          </span>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                {/* Selected Node Details Bar */}\n                {selectedPoint && (\n                  <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs font-mono\">\n                    <div className=\"flex items-center space-x-2\">\n                      <div className={`w-2.5 h-2.5 rounded-full ${selectedPoint.isCenter ? \'bg-emerald-400\' : \'bg-indigo-400\'}`}></div>\n                      <span className=\"text-white font-bold\">{selectedPoint.id}</span>\n                      <span className=\"text-slate-500\">\n                        [Row {selectedPoint.rowIndex}, Col {selectedPoint.colIndex}]\n                      </span>\n                    </div>\n\n                    <div className=\"flex items-center space-x-4 text-slate-300\">\n                      <span>\n                        Lat: <strong className=\"text-emerald-400\">{selectedPoint.lat}</strong>\n                      </span>\n                      <span>\n                        Lng: <strong className=\"text-indigo-400\">{selectedPoint.lng}</strong>\n                      </span>\n                      <span>\n                        Distance:{\' \'}\n                        <strong className=\"text-amber-400\">\n                          {selectedPoint.distanceFromCenter} {unit}\n                        </strong>\n                      </span>\n                      <span>\n                        Bearing:{\' \'}\n                        <strong className=\"text-cyan-400\">{selectedPoint.bearingFromCenterDegrees}\302\260</strong>\n                      </span>\n                    </div>\n\n                    <button\n                      onClick={() =>\n                        copyToClipboard(\n                          JSON.stringify(\n                            {\n                              lat: selectedPoint.lat,\n                              lng: selectedPoint.lng,\n                              distance: selectedPoint.distanceFromCenter,\n                              bearing: selectedPoint.bearingFromCenterDegrees,\n                            },\n                            null,\n                            2\n                          ),\n                          \'point\'\n                        )\n                      }\n                      className=\"px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700 flex items-center space-x-1\"\n                    >\n                      {copiedSection === \'point\' ? <Check className=\"w-3 h-3 text-emerald-400\" /> : <Copy className=\"w-3 h-3\" />}\n                      <span>Copy</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Generated Points Table & Export */}\n            <div className=\"bg-slate-900 rounded-2xl border border-slate-800 p-5 space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h3 className=\"text-sm font-semibold text-white\">Full Coordinate Data Table</h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Exact calculated geodesic points ready for dispatching to SERP / DataForSEO API.\n                  </p>\n                </div>\n                <button\n                  onClick={() => copyToClipboard(JSON.stringify(gridResult, null, 2), \'fullGrid\')}\n                  className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-medium border border-slate-700 flex items-center space-x-1.5 transition\"\n                >\n                  {copiedSection === \'fullGrid\' ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                      <span>Copied JSON</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy Grid JSON</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div className=\"overflow-x-auto max-h-64 overflow-y-auto rounded-lg border border-slate-800\">\n                <table className=\"w-full text-left text-xs font-mono\">\n                  <thead className=\"bg-slate-950 text-slate-400 uppercase tracking-wider sticky top-0\">\n                    <tr>\n                      <th className=\"py-2.5 px-3\">Node ID</th>\n                      <th className=\"py-2.5 px-3\">Row, Col</th>\n                      <th className=\"py-2.5 px-3\">Latitude</th>\n                      <th className=\"py-2.5 px-3\">Longitude</th>\n                      <th className=\"py-2.5 px-3\">Offset N/S</th>\n                      <th className=\"py-2.5 px-3\">Offset E/W</th>\n                      <th className=\"py-2.5 px-3\">Haversine Distance</th>\n                      <th className=\"py-2.5 px-3\">Bearing</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-800/60 bg-slate-900/50\">\n                    {gridResult.points.map((p) => (\n                      <tr\n                        key={p.id}\n                        className={`hover:bg-slate-850 transition ${p.isCenter ? \'bg-emerald-950/20 text-emerald-300\' : \'\'}`}\n                      >\n                        <td className=\"py-2 px-3 font-semibold text-white\">{p.id}</td>\n                        <td className=\"py-2 px-3 text-slate-400\">({p.rowIndex}, {p.colIndex})</td>\n                        <td className=\"py-2 px-3 text-emerald-400\">{p.lat}</td>\n                        <td className=\"py-2 px-3 text-indigo-400\">{p.lng}</td>\n                        <td className=\"py-2 px-3 text-slate-300\">{p.offsetNorth > 0 ? `+${p.offsetNorth}` : p.offsetNorth} {unit}</td>\n                        <td className=\"py-2 px-3 text-slate-300\">{p.offsetEast > 0 ? `+${p.offsetEast}` : p.offsetEast} {unit}</td>\n                        <td className=\"py-2 px-3 text-amber-400 font-semibold\">{p.distanceFromCenter} {unit}</td>\n                        <td className=\"py-2 px-3 text-cyan-400\">{p.bearingFromCenterDegrees}\302\260</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* ========================================================= */}\n        {/* TAB 2: SERP API LOCAL MAPS RANK PARSER                     */}\n        {/* ========================================================= */}\n        {activeTab === \'parser\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80\">\n              <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                <Search className=\"w-5 h-5 text-indigo-400\" />\n                Item 2: DataForSEO / SERP API Local Maps Rank Parser\n              </h1>\n              <p className=\"text-sm text-slate-400 mt-1 max-w-2xl\">\n                Scans 20-pack Google Local SERP responses, resolves target businesses by Place ID,\n                normalized domain, or fuzzy company name, flags status colors, and extracts dominant competitors.\n              </p>\n            </div>\n\n            {/* Parser Controls & Output */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              {/* Target Search Tester */}\n              <div className=\"lg:col-span-5 bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                <h2 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                  Target Business Identifier\n                </h2>\n\n                <div className=\"flex bg-slate-950 p-1 rounded-xl border border-slate-800\">\n                  <button\n                    onClick={() => setTargetType(\'name\')}\n                    className={`flex-1 py-1.5 text-xs rounded-lg font-medium transition ${\n                      targetType === \'name\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                    }`}\n                  >\n                    Business Name\n                  </button>\n                  <button\n                    onClick={() => setTargetType(\'domain\')}\n                    className={`flex-1 py-1.5 text-xs rounded-lg font-medium transition ${\n                      targetType === \'domain\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                    }`}\n                  >\n                    Domain / URL\n                  </button>\n                  <button\n                    onClick={() => setTargetType(\'placeId\')}\n                    className={`flex-1 py-1.5 text-xs rounded-lg font-medium transition ${\n                      targetType === \'placeId\' ? \'bg-indigo-600 text-white\' : \'text-slate-400 hover:text-white\'\n                    }`}\n                  >\n                    Place ID\n                  </button>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {targetType === \'name\' && (\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Target Business Name</label>\n                      <input\n                        type=\"text\"\n                        value={queryName}\n                        onChange={(e) => setQueryName(e.target.value)}\n                        placeholder=\"e.g. Apex Emergency Plumbing\"\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500\"\n                      />\n                      <div className=\"flex flex-wrap gap-1.5 mt-2\">\n                        <span className=\"text-[11px] text-slate-500\">Quick tests:</span>\n                        <button\n                          onClick={() => {\n                            setQueryName(\'Apex Emergency Plumbing Austin\');\n                            parseLocalSerpRank({ businessName: \'Apex Emergency Plumbing Austin\' }, MOCK_LOCAL_SERP_ITEMS);\n                          }}\n                          className=\"text-[11px] text-emerald-400 hover:underline\"\n                        >\n                          Apex (Rank 1)\n                        </button>\n                        <span>\342\200\242</span>\n                        <button\n                          onClick={() => setQueryName(\'Blue Wave Plumbing Co LLC\')}\n                          className=\"text-[11px] text-amber-400 hover:underline\"\n                        >\n                          Blue Wave (Rank 5 + Suffix)\n                        </button>\n                        <span>\342\200\242</span>\n                        <button\n                          onClick={() => setQueryName(\'Oak Hill Express Rooter\')}\n                          className=\"text-[11px] text-rose-400 hover:underline\"\n                        >\n                          Oak Hill (Rank 11)\n                        </button>\n                        <span>\342\200\242</span>\n                        <button\n                          onClick={() => setQueryName(\'Unranked Roofing Specialists\')}\n                          className=\"text-[11px] text-slate-400 hover:underline\"\n                        >\n                          Not Found (&gt;20)\n                        </button>\n                      </div>\n                    </div>\n                  )}\n\n                  {targetType === \'domain\' && (\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Website URL or Root Domain</label>\n                      <input\n                        type=\"text\"\n                        value={queryDomain}\n                        onChange={(e) => setQueryDomain(e.target.value)}\n                        placeholder=\"e.g. https://apexplumbingaustin.com\"\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono\"\n                      />\n                      <p className=\"text-[11px] text-slate-500 mt-1\">\n                        Engine normalizes https://, www., and sub-paths automatically.\n                      </p>\n                    </div>\n                  )}\n\n                  {targetType === \'placeId\' && (\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Google Place ID</label>\n                      <input\n                        type=\"text\"\n                        value={queryPlaceId}\n                        onChange={(e) => setQueryPlaceId(e.target.value)}\n                        placeholder=\"e.g. ChIJ_apex_plumbing_01\"\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono\"\n                      />\n                      <p className=\"text-[11px] text-slate-500 mt-1\">\n                        Deterministic 1:1 match against Google CID/Place ID.\n                      </p>\n                    </div>\n                  )}\n\n                  <button\n                    onClick={handleRunParser}\n                    className=\"w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-sm font-semibold transition flex items-center justify-center space-x-1.5 shadow-md shadow-indigo-600/20\"\n                  >\n                    <Search className=\"w-4 h-4\" />\n                    <span>Run SERP Rank Parser</span>\n                  </button>\n                </div>\n\n                {/* Parsed Result Summary Card */}\n                <div className=\"pt-4 border-t border-slate-800 space-y-3\">\n                  <h3 className=\"text-xs font-semibold uppercase tracking-wider text-slate-400\">\n                    Scan Result Summary\n                  </h3>\n\n                  <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs text-slate-400\">Calculated Rank:</span>\n                      <div className=\"flex items-center space-x-2\">\n                        <span\n                          className={`px-3 py-1 text-sm font-bold rounded-lg border ${\n                            scanResult.statusColor === \'green\'\n                              ? \'bg-emerald-500/20 text-emerald-400 border-emerald-500/30\'\n                              : scanResult.statusColor === \'yellow\'\n                              ? \'bg-amber-500/20 text-amber-400 border-amber-500/30\'\n                              : \'bg-rose-500/20 text-rose-400 border-rose-500/30\'\n                          }`}\n                        >\n                          Position #{scanResult.rankDisplay}\n                        </span>\n                        <span\n                          className={`text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded ${\n                            scanResult.statusColor === \'green\'\n                              ? \'text-emerald-400 bg-emerald-950\'\n                              : scanResult.statusColor === \'yellow\'\n                              ? \'text-amber-400 bg-amber-950\'\n                              : \'text-rose-400 bg-rose-950\'\n                          }`}\n                        >\n                          {scanResult.statusColor}\n                        </span>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"text-slate-400\">Target Match:</span>\n                      <span className=\"text-slate-200 font-mono\">\n                        {scanResult.targetFound ? (\n                          <span className=\"text-emerald-400\">Matched via {scanResult.matchedBy}</span>\n                        ) : (\n                          <span className=\"text-rose-400\">Not in Top 20</span>\n                        )}\n                      </span>\n                    </div>\n\n                    {scanResult.matchedBusiness && (\n                      <div className=\"p-2.5 bg-slate-900 rounded-lg border border-slate-800 text-xs space-y-1\">\n                        <div className=\"font-semibold text-white\">{scanResult.matchedBusiness.name}</div>\n                        <div className=\"text-slate-400\">{scanResult.matchedBusiness.address}</div>\n                        <div className=\"flex items-center space-x-2 text-[11px] text-slate-400\">\n                          <span className=\"text-amber-400 font-bold\">\342\230\205 {scanResult.matchedBusiness.rating}</span>\n                          <span>({scanResult.matchedBusiness.reviews} reviews)</span>\n                          <span>\342\200\242</span>\n                          <span className=\"text-indigo-400\">{scanResult.matchedBusiness.category}</span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n\n              {/* Right: Competitor Analysis & Full 20-Pack View */}\n              <div className=\"lg:col-span-7 bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h2 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                      Top 3 Competing Businesses (Capturing Local Pack)\n                    </h2>\n                    <p className=\"text-xs text-slate-500\">\n                      Primary competitors dominating the centroid and weak zones\n                    </p>\n                  </div>\n                  <span className=\"text-xs px-2.5 py-1 bg-indigo-500/10 text-indigo-400 rounded-full border border-indigo-500/20\">\n                    Excludes target business\n                  </span>\n                </div>\n\n                {/* Top 3 Competitors Cards */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  {scanResult.topCompetitors.map((comp, idx) => (\n                    <div\n                      key={comp.place_id || comp.name}\n                      className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800/80 flex flex-col justify-between\"\n                    >\n                      <div className=\"space-y-1\">\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"text-[10px] font-bold px-1.5 py-0.5 bg-slate-800 text-slate-300 rounded font-mono\">\n                            #{comp.rank_position}\n                          </span>\n                          <span className=\"text-[11px] text-amber-400 font-semibold\">\n                            \342\230\205 {comp.rating} ({comp.reviews})\n                          </span>\n                        </div>\n                        <h4 className=\"text-xs font-bold text-white line-clamp-2\">{comp.name}</h4>\n                        <p className=\"text-[11px] text-slate-400 line-clamp-1\">{comp.address}</p>\n                      </div>\n                      <div className=\"mt-2 pt-2 border-t border-slate-850 flex items-center justify-between text-[10px] text-indigo-400 font-mono\">\n                        <span>{comp.category || \'Local Business\'}</span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n\n                {/* Full Mocked 20-Pack SERP Inspection Table */}\n                <div className=\"pt-2\">\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-xs font-semibold text-slate-300\">\n                      Scanned 20-Pack Local Results ({MOCK_LOCAL_SERP_ITEMS.length} items)\n                    </span>\n                    <span className=\"text-[11px] text-slate-500\">Google Maps SERP Array</span>\n                  </div>\n\n                  <div className=\"overflow-x-auto max-h-72 overflow-y-auto rounded-lg border border-slate-800\">\n                    <table className=\"w-full text-left text-xs\">\n                      <thead className=\"bg-slate-950 text-slate-400 uppercase tracking-wider sticky top-0 text-[11px]\">\n                        <tr>\n                          <th className=\"py-2 px-3\">Rank</th>\n                          <th className=\"py-2 px-3\">Business Name</th>\n                          <th className=\"py-2 px-3\">Rating</th>\n                          <th className=\"py-2 px-3\">Domain</th>\n                          <th className=\"py-2 px-3\">Place ID</th>\n                        </tr>\n                      </thead>\n                      <tbody className=\"divide-y divide-slate-800/60 font-mono bg-slate-900/40\">\n                        {MOCK_LOCAL_SERP_ITEMS.map((item) => {\n                          const isTarget = scanResult.matchedBusiness?.place_id === item.place_id;\n                          return (\n                            <tr\n                              key={item.rank_position}\n                              className={`transition ${\n                                isTarget\n                                  ? \'bg-indigo-950/40 border-l-2 border-indigo-400 text-white font-semibold\'\n                                  : \'hover:bg-slate-850 text-slate-300\'\n                              }`}\n                            >\n                              <td className=\"py-2 px-3\">\n                                <span\n                                  className={`px-1.5 py-0.5 rounded text-[11px] font-bold ${\n                                    item.rank_position <= 3\n                                      ? \'bg-emerald-500/20 text-emerald-400\'\n                                      : item.rank_position <= 10\n                                      ? \'bg-amber-500/20 text-amber-400\'\n                                      : \'bg-rose-500/20 text-rose-400\'\n                                  }`}\n                                >\n                                  #{item.rank_position}\n                                </span>\n                              </td>\n                              <td className=\"py-2 px-3 font-sans text-white\">\n                                {item.name}\n                                {isTarget && (\n                                  <span className=\"ml-2 text-[10px] px-1.5 py-0.2 bg-indigo-500 text-white rounded\">\n                                    Target Match\n                                  </span>\n                                )}\n                              </td>\n                              <td className=\"py-2 px-3 text-amber-400\">\n                                \342\230\205 {item.rating} ({item.reviews})\n                              </td>\n                              <td className=\"py-2 px-3 text-indigo-400 truncate max-w-[140px]\">{item.domain}</td>\n                              <td className=\"py-2 px-3 text-slate-500 truncate max-w-[120px]\">{item.place_id}</td>\n                            </tr>\n                          );\n                        })}\n                      </tbody>\n                    </table>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* ========================================================= */}\n        {/* TAB 3: AI AUDIT & PITCH GENERATOR                          */}\n        {/* ========================================================= */}\n        {activeTab === \'audit\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div>\n                <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                  <Sparkles className=\"w-5 h-5 text-amber-300\" />\n                  Item 3: Local SEO AI Audit & Cold Outreach Pitch Generator\n                </h1>\n                <p className=\"text-sm text-slate-400 mt-1 max-w-2xl\">\n                  Translates raw Geo-Grid telemetry and 3-Pack dropoff metrics into a persuasive,\n                  data-backed executive audit and conversational cold prospecting email.\n                </p>\n              </div>\n\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"text-xs text-slate-400\">Source:</span>\n                <span className=\"px-2.5 py-1 text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-full\">\n                  {generationSource}\n                </span>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              {/* Prospecting Inputs */}\n              <div className=\"lg:col-span-4 bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                <h2 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                  Client Audit Inputs\n                </h2>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">Target Business Name</label>\n                    <input\n                      type=\"text\"\n                      value={auditBusinessName}\n                      onChange={(e) => setAuditBusinessName(e.target.value)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">GBP Category / Niche</label>\n                    <input\n                      type=\"text\"\n                      value={auditCategory}\n                      onChange={(e) => setAuditCategory(e.target.value)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">Target Market / Metro</label>\n                    <input\n                      type=\"text\"\n                      value={targetMarket}\n                      onChange={(e) => setTargetMarket(e.target.value)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3 pt-1\">\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">Average Grid Rank</label>\n                      <input\n                        type=\"number\"\n                        step=\"0.1\"\n                        value={avgRank}\n                        onChange={(e) => setAvgRank(parseFloat(e.target.value) || 0)}\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-rose-400 font-mono font-bold\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"text-xs text-slate-400 block mb-1\">% in Top 3</label>\n                      <input\n                        type=\"number\"\n                        step=\"1\"\n                        value={top3Pct}\n                        onChange={(e) => setTop3Pct(parseFloat(e.target.value) || 0)}\n                        className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-amber-400 font-mono font-bold\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs text-slate-400 block mb-1\">Total Grid Coordinates</label>\n                    <input\n                      type=\"number\"\n                      value={totalNodes}\n                      onChange={(e) => setTotalNodes(parseInt(e.target.value) || 25)}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-300 font-mono\"\n                    />\n                  </div>\n\n                  <button\n                    onClick={handleGenerateAudit}\n                    disabled={isGeneratingAudit}\n                    className=\"w-full mt-2 py-2.5 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white rounded-lg text-sm font-semibold transition flex items-center justify-center space-x-2 shadow-lg shadow-indigo-600/25 disabled:opacity-50\"\n                  >\n                    {isGeneratingAudit ? (\n                      <>\n                        <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                        <span>Synthesizing via Gemini...</span>\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles className=\"w-4 h-4 text-amber-300\" />\n                        <span>Generate Audit & Pitch</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n\n                {/* Prompt Template Preview Drawer */}\n                <div className=\"pt-3 border-t border-slate-800\">\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <span className=\"text-xs font-semibold text-slate-400\">Gemini Prompt Structure</span>\n                    <button\n                      onClick={() =>\n                        copyToClipboard(\n                          buildLocalSeoAuditPrompt({\n                            businessName: auditBusinessName,\n                            category: auditCategory,\n                            metrics: {\n                              averageRank: avgRank,\n                              top3Percentage: top3Pct,\n                              totalNodesScanned: totalNodes,\n                              targetMarket,\n                            },\n                            topCompetitorsInWeakZones: [\n                              { name: \'Apex Emergency Plumbing\', rating: 4.9, reviews: 342 },\n                              { name: \'Capital City Water Heaters\', rating: 4.8, reviews: 215 },\n                            ],\n                          }),\n                          \'prompt\'\n                        )\n                      }\n                      className=\"text-[11px] text-indigo-400 hover:underline flex items-center space-x-1\"\n                    >\n                      {copiedSection === \'prompt\' ? <Check className=\"w-3 h-3\" /> : <Copy className=\"w-3 h-3\" />}\n                      <span>Copy Prompt</span>\n                    </button>\n                  </div>\n                  <div className=\"p-2.5 bg-slate-950 rounded-lg border border-slate-800/80 text-[11px] text-slate-400 font-mono line-clamp-4\">\n                    {buildLocalSeoAuditPrompt({\n                      businessName: auditBusinessName,\n                      category: auditCategory,\n                      metrics: {\n                        averageRank: avgRank,\n                        top3Percentage: top3Pct,\n                        totalNodesScanned: totalNodes,\n                        targetMarket,\n                      },\n                      topCompetitorsInWeakZones: [\n                        { name: \'Apex Emergency Plumbing\', rating: 4.9, reviews: 342 },\n                      ],\n                    })}\n                  </div>\n                </div>\n              </div>\n\n              {/* Structured AI Output Display */}\n              <div className=\"lg:col-span-8 space-y-5\">\n                {/* Executive Summary & Missed Revenue Cards */}\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2\">\n                    <div className=\"flex items-center space-x-2 text-indigo-400\">\n                      <BarChart3 className=\"w-4 h-4\" />\n                      <h3 className=\"text-xs font-bold uppercase tracking-wider\">Executive Visibility Summary</h3>\n                    </div>\n                    <p className=\"text-xs leading-relaxed text-slate-300\">\n                      {auditOutput.executiveSummary}\n                    </p>\n                  </div>\n\n                  <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2\">\n                    <div className=\"flex items-center space-x-2 text-amber-400\">\n                      <DollarSign className=\"w-4 h-4\" />\n                      <h3 className=\"text-xs font-bold uppercase tracking-wider\">Missed Revenue & Call Deficit</h3>\n                    </div>\n                    <p className=\"text-xs leading-relaxed text-slate-300\">\n                      {auditOutput.missedRevenueEstimate}\n                    </p>\n                  </div>\n                </div>\n\n                {/* 4 Tactical Action Steps */}\n                <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <h3 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2\">\n                      <Layers className=\"w-4 h-4 text-emerald-400\" />\n                      4 Tactical Grid-Reclaiming Action Steps\n                    </h3>\n                    <span className=\"text-xs text-slate-500 font-mono\">Zod Validated</span>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1\">\n                      <div className=\"text-[11px] font-bold text-emerald-400 uppercase tracking-wide\">\n                        1. GBP Category Optimization\n                      </div>\n                      <p className=\"text-xs text-slate-300 leading-relaxed\">\n                        {auditOutput.actionPlan.gbpCategories}\n                      </p>\n                    </div>\n\n                    <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1\">\n                      <div className=\"text-[11px] font-bold text-cyan-400 uppercase tracking-wide\">\n                        2. NAP Citations & Geo-Entities\n                      </div>\n                      <p className=\"text-xs text-slate-300 leading-relaxed\">\n                        {auditOutput.actionPlan.citations}\n                      </p>\n                    </div>\n\n                    <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1\">\n                      <div className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wide\">\n                        3. Geo-Targeted Review Velocity\n                      </div>\n                      <p className=\"text-xs text-slate-300 leading-relaxed\">\n                        {auditOutput.actionPlan.reviews}\n                      </p>\n                    </div>\n\n                    <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1\">\n                      <div className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-wide\">\n                        4. Localized On-Page Content & Schema\n                      </div>\n                      <p className=\"text-xs text-slate-300 leading-relaxed\">\n                        {auditOutput.actionPlan.onPageLocalizedContent}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Cold Outreach Pitch Generator */}\n                <div className=\"bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center space-x-2\">\n                      <Mail className=\"w-4 h-4 text-indigo-400\" />\n                      <h3 className=\"text-sm font-semibold uppercase tracking-wider text-slate-400\">\n                        High-Converting Cold Outreach Prospecting Hook\n                      </h3>\n                    </div>\n                    <button\n                      onClick={() =>\n                        copyToClipboard(\n                          `Subject: ${auditOutput.coldOutreachPitch.subjectLine}\\n\\n${auditOutput.coldOutreachPitch.emailBody}`,\n                          \'email\'\n                        )\n                      }\n                      className=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-xs flex items-center space-x-1 border border-slate-700 transition\"\n                    >\n                      {copiedSection === \'email\' ? (\n                        <>\n                          <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                          <span>Copied Email</span>\n                        </>\n                      ) : (\n                        <>\n                          <Copy className=\"w-3.5 h-3.5\" />\n                          <span>Copy Email</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n                  <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3 font-sans\">\n                    <div className=\"pb-2 border-b border-slate-850\">\n                      <span className=\"text-[11px] text-slate-500 uppercase font-mono block\">Subject Line</span>\n                      <span className=\"text-sm font-semibold text-white\">\n                        {auditOutput.coldOutreachPitch.subjectLine}\n                      </span>\n                    </div>\n\n                    <div>\n                      <span className=\"text-[11px] text-slate-500 uppercase font-mono block mb-1\">Email Body</span>\n                      <div className=\"text-xs text-slate-300 whitespace-pre-line leading-relaxed font-normal bg-slate-900/60 p-3 rounded-lg border border-slate-850\">\n                        {auditOutput.coldOutreachPitch.emailBody}\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-slate-850\">\n                      <span className=\"text-[11px] text-slate-500 uppercase font-mono block mb-0.5\">\n                        30-Second Follow-up SMS / Voicemail Hook\n                      </span>\n                      <p className=\"text-xs text-slate-400 italic\">\n                        \"{auditOutput.coldOutreachPitch.smsOrVoicemailScript}\"\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* ========================================================= */}\n        {/* TAB 4: AUTOMATED TEST SUITE                                */}\n        {/* ========================================================= */}\n        {activeTab === \'tests\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div>\n                <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                  <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n                  Engine Automated Test Runner & Verification\n                </h1>\n                <p className=\"text-sm text-slate-400 mt-1 max-w-2xl\">\n                  Unit tests validating geodesic math formulas, SERP parser matching rules, and Zod\n                  schema constraints for the Local SEO Geo-Grid prototype.\n                </p>\n              </div>\n\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"flex items-center space-x-1.5 px-3 py-1.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-xl text-xs font-semibold\">\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  <span>\n                    {testResults.passCount} of {testResults.totalTests} Passed\n                  </span>\n                </div>\n                <button\n                  onClick={handleRerunTests}\n                  className=\"px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold flex items-center space-x-1.5 transition\"\n                >\n                  <RefreshCw className=\"w-3.5 h-3.5\" />\n                  <span>Rerun Test Suite</span>\n                </button>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              {testResults.results.map((t, idx) => (\n                <div\n                  key={idx}\n                  className={`p-4 rounded-xl border transition flex items-start justify-between ${\n                    t.passed\n                      ? \'bg-slate-900 border-slate-800/90\'\n                      : \'bg-rose-950/20 border-rose-800\'\n                  }`}\n                >\n                  <div className=\"flex items-start space-x-3\">\n                    <div className=\"mt-0.5\">\n                      {t.passed ? (\n                        <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n                      ) : (\n                        <XCircle className=\"w-5 h-5 text-rose-400\" />\n                      )}\n                    </div>\n                    <div>\n                      <div className=\"flex items-center space-x-2\">\n                        <span className=\"text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-slate-800 text-indigo-400\">\n                          {t.suite}\n                        </span>\n                        <h4 className=\"text-sm font-semibold text-white\">{t.name}</h4>\n                      </div>\n                      <p className=\"text-xs text-slate-400 mt-1\">{t.message}</p>\n                    </div>\n                  </div>\n\n                  <div className=\"text-right flex flex-col items-end\">\n                    <span className=\"text-xs font-mono text-slate-500\">{t.durationMs}ms</span>\n                    <span\n                      className={`text-[10px] font-bold uppercase mt-1 px-1.5 py-0.2 rounded ${\n                        t.passed ? \'bg-emerald-950 text-emerald-400\' : \'bg-rose-950 text-rose-400\'\n                      }`}\n                    >\n                      {t.passed ? \'PASSED\' : \'FAILED\'}\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* ========================================================= */}\n        {/* TAB 5: TYPESCRIPT CODE & SCHEMA REFERENCE                 */}\n        {/* ========================================================= */}\n        {activeTab === \'code\' && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80\">\n              <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                <FileCode2 className=\"w-5 h-5 text-indigo-400\" />\n                Complete Modular TypeScript Implementation Reference\n              </h1>\n              <p className=\"text-sm text-slate-400 mt-1 max-w-2xl\">\n                Ready-to-use TypeScript modules for your prototype: Coordinate Grid Math, DataForSEO SERP Parser,\n                and Gemini Structured Output schema.\n              </p>\n            </div>\n\n            <div className=\"space-y-6\">\n              {/* Module 1 Code Snippet */}\n              <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden\">\n                <div className=\"p-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"text-xs font-bold text-white font-mono\">src/engine/geoGrid.ts</span>\n                    <span className=\"text-xs text-slate-500\">\342\200\242 Geodesic Math & N\303\227N Grid</span>\n                  </div>\n                  <button\n                    onClick={() =>\n                      copyToClipboard(\n                        `// Geodesic Grid Generator\\nimport { generateGeoGrid } from \'./src/engine/geoGrid\';\\nconst grid = generateGeoGrid({ center: { lat: 30.2672, lng: -97.7431 }, gridSize: 5, distanceStep: 1.0, unit: \'km\' });`,\n                        \'code1\'\n                      )\n                    }\n                    className=\"text-xs text-indigo-400 hover:text-indigo-300 flex items-center space-x-1\"\n                  >\n                    {copiedSection === \'code1\' ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>Copy Usage</span>\n                  </button>\n                </div>\n                <pre className=\"p-4 text-xs font-mono text-slate-300 overflow-x-auto max-h-72 bg-slate-950/60\">\n{`export function generateGeoGrid(config: GridGeneratorConfig): GridResult {\n  const { center, gridSize, distanceStep, unit = \'km\' } = config;\n  const R = EARTH_RADIUS[unit]; // 6371.0088 km\n  const centerRow = (gridSize - 1) / 2;\n  const centerCol = (gridSize - 1) / 2;\n\n  const points: GridPoint[] = [];\n  for (let r = 0; r < gridSize; r++) {\n    const deltaY = (centerRow - r) * distanceStep; // North(+) / South(-)\n    const deltaLatRad = deltaY / R;\n    const pointLat = center.lat + toDegrees(deltaLatRad);\n    const avgLatRad = toRadians((center.lat + pointLat) / 2);\n    const cosLat = Math.cos(avgLatRad);\n\n    for (let c = 0; c < gridSize; c++) {\n      const deltaX = (c - centerCol) * distanceStep; // East(+) / West(-)\n      const deltaLngRad = deltaX / (R * cosLat);\n      const pointLng = center.lng + toDegrees(deltaLngRad);\n\n      points.push({\n        id: \\`node_r\\${r}_c\\${c}\\`,\n        rowIndex: r,\n        colIndex: c,\n        lat: Number(pointLat.toFixed(6)),\n        lng: Number(pointLng.toFixed(6)),\n        distanceFromCenter: haversineDistance(center, { lat: pointLat, lng: pointLng }, unit),\n        bearingFromCenterDegrees: calculateBearing(center, { lat: pointLat, lng: pointLng }),\n        isCenter: r === centerRow && c === centerCol,\n        unit\n      });\n    }\n  }\n  return { center, gridSize, totalPoints: points.length, distanceStep, points };\n}`}\n                </pre>\n              </div>\n\n              {/* Module 2 Code Snippet */}\n              <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden\">\n                <div className=\"p-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"text-xs font-bold text-white font-mono\">src/engine/serpParser.ts</span>\n                    <span className=\"text-xs text-slate-500\">\342\200\242 Place ID, Domain & Name Matcher</span>\n                  </div>\n                  <button\n                    onClick={() =>\n                      copyToClipboard(\n                        `// SERP Parser\\nimport { parseLocalSerpRank } from \'./src/engine/serpParser\';\\nconst result = parseLocalSerpRank({ businessName: \"Apex Emergency Plumbing\" }, mockSerpArray);`,\n                        \'code2\'\n                      )\n                    }\n                    className=\"text-xs text-indigo-400 hover:text-indigo-300 flex items-center space-x-1\"\n                  >\n                    {copiedSection === \'code2\' ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>Copy Usage</span>\n                  </button>\n                </div>\n                <pre className=\"p-4 text-xs font-mono text-slate-300 overflow-x-auto max-h-72 bg-slate-950/60\">\n{`export function parseLocalSerpRank(\n  target: TargetBusinessIdentifier,\n  serpItems: SerpLocalItem[]\n): PinScanResult {\n  const items = [...serpItems].sort((a, b) => a.rank_position - b.rank_position);\n  let matchedIndex = -1;\n  let matchMethod: \'place_id\' | \'domain\' | \'business_name\' | \'none\' = \'none\';\n\n  // 1. Google Place ID exact match\n  // 2. Domain / URL match (normalized without https/www)\n  // 3. Normalized business name (with corporate suffix stripping)\n  // ...\n  const targetFound = matchedIndex !== -1;\n  const matchedItem = targetFound ? items[matchedIndex] : null;\n  const rank = matchedItem ? matchedItem.rank_position : null;\n\n  let statusColor: \'green\' | \'yellow\' | \'red\' = \'red\';\n  if (rank !== null && rank <= 3) statusColor = \'green\';\n  else if (rank !== null && rank <= 10) statusColor = \'yellow\';\n\n  const topCompetitors = items.filter((_, idx) => idx !== matchedIndex).slice(0, 3);\n  return { targetFound, rank, rankDisplay: rank ? String(rank) : \'>20\', statusColor, topCompetitors };\n}`}\n                </pre>\n              </div>\n\n              {/* Module 3 Zod & Gemini Output */}\n              <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden\">\n                <div className=\"p-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"text-xs font-bold text-white font-mono\">src/engine/aiAuditPitch.ts</span>\n                    <span className=\"text-xs text-slate-500\">\342\200\242 Zod Schema & Structured Output</span>\n                  </div>\n                  <button\n                    onClick={() => copyToClipboard(JSON.stringify(SAMPLE_AUDIT_PITCH_JSON, null, 2), \'code3\')}\n                    className=\"text-xs text-indigo-400 hover:text-indigo-300 flex items-center space-x-1\"\n                  >\n                    {copiedSection === \'code3\' ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>Copy Sample JSON</span>\n                  </button>\n                </div>\n                <pre className=\"p-4 text-xs font-mono text-slate-300 overflow-x-auto max-h-72 bg-slate-950/60\">\n{`export const LocalSeoAuditPitchSchema = z.object({\n  executiveSummary: z.string(),\n  missedRevenueEstimate: z.string(),\n  actionPlan: z.object({\n    gbpCategories: z.string(),\n    citations: z.string(),\n    reviews: z.string(),\n    onPageLocalizedContent: z.string(),\n  }),\n  coldOutreachPitch: z.object({\n    subjectLine: z.string(),\n    emailBody: z.string(),\n    smsOrVoicemailScript: z.string(),\n  }),\n});`}\n                </pre>\n              </div>\n            </div>\n          </div>\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-slate-800 bg-slate-950 py-4 text-center text-xs text-slate-500\">\n        GeoRank Pro \342\200\242 Foundational Engine Logic for Local Falcon / ProfitMaps AI Alternative \342\200\242 TypeScript & Geodesic WGS-84 Math\n      </footer>\n    </div>\n  );\n}\n"
