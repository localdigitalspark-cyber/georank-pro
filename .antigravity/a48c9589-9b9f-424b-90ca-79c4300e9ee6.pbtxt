    model_api_content_id: "bhPRaqi8A9CEvdIP-M7NmAI"
  }
  planner_response {
    response: "Here is the complete, tested core engine architecture for your Local SEO Geo-Grid Rank Tracker and Prospecting SaaS prototype (comparable to ProfitMaps AI and Local Falcon).\n\n---\n\n### Item 1: Geodesic Coordinate Grid Generator (`src/engine/geoGrid.ts`)\n\nImplements exact geodesic math with meridional convergence scaling ($\\cos(\\phi)$ adjustment for longitude spacing) and Haversine distance/bearing calculations suitable for high-accuracy local ranking radii (0.1 km to 50+ km).\n\n```typescript\n/**\n * Local SEO Geo-Grid Coordinate Generator\n * Calculates an equidistant N x N matrix of geographic coordinates centered\n * around a target business or latitude/longitude location.\n */\n\nexport type DistanceUnit = \'km\' | \'mi\';\n\nexport interface GeoCoordinate {\n  lat: number;\n  lng: number;\n}\n\nexport interface GridGeneratorConfig {\n  /** Center coordinate (e.g. Google Business Profile latitude & longitude) */\n  center: GeoCoordinate;\n  /** Grid dimension: odd integer like 3, 5, 7, 9 (e.g. 5 yields a 5x5 grid of 25 nodes) */\n  gridSize: number;\n  /** Distance step between adjacent pins (e.g. 1.0 km or 0.5 mi) */\n  distanceStep: number;\n  /** Unit of distance: \'km\' (default) or \'mi\' */\n  unit?: DistanceUnit;\n}\n\nexport interface GridPoint {\n  id: string;\n  rowIndex: number; // 0 (North-most) to gridSize - 1 (South-most)\n  colIndex: number; // 0 (West-most) to gridSize - 1 (East-most)\n  lat: number;\n  lng: number;\n  offsetNorth: number; // Positive = North, Negative = South\n  offsetEast: number;  // Positive = East, Negative = West\n  distanceFromCenter: number; // True geodesic distance from center\n  bearingFromCenterDegrees: number; // 0\302\260 = North, 90\302\260 = East, 180\302\260 = South, 270\302\260 = West\n  isCenter: boolean;\n  unit: DistanceUnit;\n}\n\nexport interface GridResult {\n  center: GeoCoordinate;\n  gridSize: number;\n  totalPoints: number;\n  distanceStep: number;\n  unit: DistanceUnit;\n  points: GridPoint[];\n  bounds: {\n    north: number;\n    south: number;\n    east: number;\n    west: number;\n  };\n}\n\n/** Earth radius in kilometers and miles (WGS-84 / IUGG) */\nexport const EARTH_RADIUS = {\n  km: 6371.0088,\n  mi: 3958.7613,\n} as const;\n\nexport function toRadians(degrees: number): number {\n  return (degrees * Math.PI) / 180;\n}\n\nexport function toDegrees(radians: number): number {\n  return (radians * 180) / Math.PI;\n}\n\n/**\n * Calculates exact great-circle distance between two points using the Haversine formula.\n */\nexport function haversineDistance(\n  coord1: GeoCoordinate,\n  coord2: GeoCoordinate,\n  unit: DistanceUnit = \'km\'\n): number {\n  const R = EARTH_RADIUS[unit];\n  const dLat = toRadians(coord2.lat - coord1.lat);\n  const dLng = toRadians(coord2.lng - coord1.lng);\n  const lat1 = toRadians(coord1.lat);\n  const lat2 = toRadians(coord2.lat);\n\n  const a =\n    Math.sin(dLat / 2) * Math.sin(dLat / 2) +\n    Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) * Math.sin(dLng / 2);\n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n\n  return R * c;\n}\n\n/**\n * Calculates initial bearing from coord1 to coord2 in degrees (0\302\260..360\302\260).\n */\nexport function calculateBearing(coord1: GeoCoordinate, coord2: GeoCoordinate): number {\n  const lat1 = toRadians(coord1.lat);\n  const lat2 = toRadians(coord2.lat);\n  const dLng = toRadians(coord2.lng - coord1.lng);\n\n  const y = Math.sin(dLng) * Math.cos(lat2);\n  const x =\n    Math.cos(lat1) * Math.sin(lat2) -\n    Math.sin(lat1) * Math.cos(lat2) * Math.cos(dLng);\n\n  const brng = toDegrees(Math.atan2(y, x));\n  return (brng + 360) % 360;\n}\n\n/**\n * Generates an N x N coordinate grid for local maps rank tracking.\n */\nexport function generateGeoGrid(config: GridGeneratorConfig): GridResult {\n  const { center, gridSize, distanceStep, unit = \'km\' } = config;\n\n  if (gridSize < 1 || !Number.isInteger(gridSize)) {\n    throw new Error(`Grid size must be a positive integer, received: ${gridSize}`);\n  }\n  if (distanceStep <= 0) {\n    throw new Error(`Distance step must be greater than 0, received: ${distanceStep}`);\n  }\n  if (center.lat < -90 || center.lat > 90) {\n    throw new Error(`Center latitude out of bounds (-90 to 90): ${center.lat}`);\n  }\n  if (center.lng < -180 || center.lng > 180) {\n    throw new Error(`Center longitude out of bounds (-180 to 180): ${center.lng}`);\n  }\n\n  const R = EARTH_RADIUS[unit];\n  const centerRow = (gridSize - 1) / 2;\n  const centerCol = (gridSize - 1) / 2;\n\n  const points: GridPoint[] = [];\n  let maxLat = -Infinity;\n  let minLat = Infinity;\n  let maxLng = -Infinity;\n  let minLng = Infinity;\n\n  for (let r = 0; r < gridSize; r++) {\n    // Row 0 is North (+), row N-1 is South (-)\n    const deltaY = (centerRow - r) * distanceStep;\n\n    // Angular distance North/South in radians\n    const deltaLatRad = deltaY / R;\n    const pointLat = center.lat + toDegrees(deltaLatRad);\n\n    // Meridional convergence adjustment at mean latitude\n    const avgLatRad = toRadians((center.lat + pointLat) / 2);\n    const cosLat = Math.cos(avgLatRad);\n    const safeCosLat = Math.abs(cosLat) < 1e-6 ? 1e-6 : cosLat;\n\n    for (let c = 0; c < gridSize; c++) {\n      // Col 0 is West (-), col N-1 is East (+)\n      const deltaX = (c - centerCol) * distanceStep;\n\n      // Angular distance East/West in radians scaled for latitude\n      const deltaLngRad = deltaX / (R * safeCosLat);\n      const pointLng = center.lng + toDegrees(deltaLngRad);\n\n      const pointCoord: GeoCoordinate = {\n        lat: Number(pointLat.toFixed(6)),\n        lng: Number(pointLng.toFixed(6)),\n      };\n\n      const isCenter = r === centerRow && c === centerCol;\n      const trueDistance = isCenter ? 0 : haversineDistance(center, pointCoord, unit);\n      const bearing = isCenter ? 0 : calculateBearing(center, pointCoord);\n\n      maxLat = Math.max(maxLat, pointCoord.lat);\n      minLat = Math.min(minLat, pointCoord.lat);\n      maxLng = Math.max(maxLng, pointCoord.lng);\n      minLng = Math.min(minLng, pointCoord.lng);\n\n      points.push({\n        id: `node_r${r}_c${c}`,\n        rowIndex: r,\n        colIndex: c,\n        lat: pointCoord.lat,\n        lng: pointCoord.lng,\n        offsetNorth: Number(deltaY.toFixed(4)),\n        offsetEast: Number(deltaX.toFixed(4)),\n        distanceFromCenter: Number(trueDistance.toFixed(3)),\n        bearingFromCenterDegrees: Number(bearing.toFixed(1)),\n        isCenter,\n        unit,\n      });\n    }\n  }\n\n  return {\n    center,\n    gridSize,\n    totalPoints: points.length,\n    distanceStep,\n    unit,\n    points,\n    bounds: {\n      north: Number(maxLat.toFixed(6)),\n      south: Number(minLat.toFixed(6)),\n      east: Number(maxLng.toFixed(6)),\n      west: Number(minLng.toFixed(6)),\n    },\n  };\n}\n```\n\n---\n\n### Item 2: DataForSEO / Google Local SERP Rank Parser (`src/engine/serpParser.ts`)\n\nHandles Place ID matching, domain/URL matching (stripping subpaths and protocols), and fuzzy corporate name matching (stripping suffixes like LLC, Inc, Corp). Extracts target rank, color tag (`green` for 1-3, `yellow` for 4-10, `red` for 11+ / unranked), and the top 3 dominant competitors excluding the target business.\n\n```typescript\n/**\n * DataForSEO / SERP API Google Local Maps Rank Parser\n */\n\nexport interface SerpLocalItem {\n  rank_position: number;\n  name: string;\n  place_id?: string;\n  cid?: string;\n  address?: string;\n  rating?: number;\n  reviews?: number;\n  reviews_count?: number;\n  url?: string;\n  domain?: string;\n  phone?: string;\n  category?: string;\n  latitude?: number;\n  longitude?: number;\n}\n\nexport interface TargetBusinessIdentifier {\n  placeId?: string;\n  businessName?: string;\n  domainOrUrl?: string;\n}\n\nexport type RankStatusColor = \'green\' | \'yellow\' | \'red\';\n\nexport interface PinScanResult {\n  targetFound: boolean;\n  rank: number | null; // 1-20 or null if >20\n  rankDisplay: string; // \"1\", \"2\", ... \"20\", or \">20\"\n  statusColor: RankStatusColor; // \'green\' (1-3), \'yellow\' (4-10), \'red\' (11+ / unranked)\n  matchedBy: \'place_id\' | \'domain\' | \'business_name\' | \'none\';\n  matchedBusiness: SerpLocalItem | null;\n  topCompetitors: SerpLocalItem[]; // Top 3 dominant competitors excluding target\n  totalResultsScanned: number;\n  scannedAt: string;\n}\n\nexport function normalizeDomain(rawUrlOrDomain?: string): string {\n  if (!rawUrlOrDomain) return \'\';\n  let str = rawUrlOrDomain.trim().toLowerCase();\n  str = str.replace(/^(https?:\\/\\/)/i, \'\').replace(/^www\\./i, \'\');\n  const slashIdx = str.indexOf(\'/\');\n  if (slashIdx !== -1) str = str.substring(0, slashIdx);\n  const queryIdx = str.indexOf(\'?\');\n  if (queryIdx !== -1) str = str.substring(0, queryIdx);\n  return str.trim();\n}\n\nexport function normalizeBusinessName(name?: string): string {\n  if (!name) return \'\';\n  let str = name.toLowerCase().trim();\n  str = str.replace(/[&+,-]/g, \' \');\n  str = str.replace(/[^a-z0-9\\s]/g, \'\');\n  str = str.replace(/\\b(llc|inc|incorporated|corp|corporation|co|company|ltd|limited|services|group)\\b/g, \'\');\n  return str.replace(/\\s+/g, \' \').trim();\n}\n\nexport function isNameMatch(targetName: string, candidateName: string): boolean {\n  const normTarget = normalizeBusinessName(targetName);\n  const normCandidate = normalizeBusinessName(candidateName);\n\n  if (!normTarget || !normCandidate) return false;\n  if (normTarget === normCandidate) return true;\n\n  if (normTarget.length >= 4 && (normCandidate.includes(normTarget) || normTarget.includes(normCandidate))) {\n    return true;\n  }\n\n  const targetTokens = normTarget.split(\' \').filter((t) => t.length > 2);\n  const candidateTokens = new Set(normCandidate.split(\' \').filter((t) => t.length > 2));\n  if (targetTokens.length === 0) return false;\n\n  const matchCount = targetTokens.filter((token) => candidateTokens.has(token)).length;\n  return matchCount / targetTokens.length >= 0.75;\n}\n\nexport function parseLocalSerpRank(\n  target: TargetBusinessIdentifier,\n  serpItems: SerpLocalItem[]\n): PinScanResult {\n  const items = [...serpItems].sort((a, b) => a.rank_position - b.rank_position);\n\n  let matchedIndex = -1;\n  let matchMethod: \'place_id\' | \'domain\' | \'business_name\' | \'none\' = \'none\';\n\n  const cleanTargetPlaceId = target.placeId?.trim();\n  const cleanTargetDomain = normalizeDomain(target.domainOrUrl);\n  const cleanTargetName = target.businessName?.trim();\n\n  for (let i = 0; i < items.length; i++) {\n    const item = items[i];\n\n    // Priority 1: Exact Place ID\n    if (cleanTargetPlaceId && item.place_id && item.place_id.trim() === cleanTargetPlaceId) {\n      matchedIndex = i;\n      matchMethod = \'place_id\';\n      break;\n    }\n\n    // Priority 2: Domain / URL match\n    if (cleanTargetDomain) {\n      const itemDomain = normalizeDomain(item.domain || item.url);\n      if (itemDomain && (itemDomain === cleanTargetDomain || itemDomain.endsWith(`.${cleanTargetDomain}`) || cleanTargetDomain.endsWith(`.${itemDomain}`))) {\n        matchedIndex = i;\n        matchMethod = \'domain\';\n        break;\n      }\n    }\n\n    // Priority 3: Fuzzy business name\n    if (cleanTargetName && isNameMatch(cleanTargetName, item.name)) {\n      matchedIndex = i;\n      matchMethod = \'business_name\';\n      break;\n    }\n  }\n\n  const targetFound = matchedIndex !== -1;\n  const matchedItem = targetFound ? items[matchedIndex] : null;\n  const rank = matchedItem ? matchedItem.rank_position : null;\n\n  let statusColor: RankStatusColor = \'red\';\n  let rankDisplay = \'>20\';\n\n  if (rank !== null) {\n    rankDisplay = String(rank);\n    if (rank >= 1 && rank <= 3) statusColor = \'green\';\n    else if (rank >= 4 && rank <= 10) statusColor = \'yellow\';\n    else statusColor = \'red\';\n  }\n\n  // Top 3 competing businesses (excluding target business)\n  const competitors = items\n    .filter((_, idx) => idx !== matchedIndex)\n    .slice(0, 3);\n\n  return {\n    targetFound,\n    rank,\n    rankDisplay,\n    statusColor,\n    matchedBy: matchMethod,\n    matchedBusiness: matchedItem,\n    topCompetitors: competitors,\n    totalResultsScanned: items.length,\n    scannedAt: new Date().toISOString(),\n  };\n}\n```\n\n---\n\n### Item 3: Local SEO AI Audit & Pitch Generator\n\n#### 1. Zod Schema (`src/engine/aiAuditPitch.ts`)\n\n```typescript\nimport { z } from \'zod\';\n\nexport const LocalSeoAuditPitchSchema = z.object({\n  executiveSummary: z.string().describe(\n    \"High-impact summary of their visibility loss across the local geo-grid and proximity-dropoff analysis\"\n  ),\n  missedRevenueEstimate: z.string().describe(\n    \"Quantified economic breakdown explaining why being pushed out of the Google 3-Pack costs 70%+ of incoming phone calls and high-intent local customer volume\"\n  ),\n  actionPlan: z.object({\n    gbpCategories: z.string().describe(\n      \"Primary & secondary Google Business Profile (GBP) category optimization and service catalogue adjustments\"\n    ),\n    citations: z.string().describe(\n      \"NAP consistency cleanup, hyper-local structured data, and local directory citation velocity\"\n    ),\n    reviews: z.string().describe(\n      \"Geo-targeted review acquisition velocity, customer keyword integration, and review response signals\"\n    ),\n    onPageLocalizedContent: z.string().describe(\n      \"Localized landing pages, city/neighborhood service area content, and LocalBusiness schema markup\"\n    ),\n  }),\n  coldOutreachPitch: z.object({\n    subjectLine: z.string().describe(\n      \"Punchy, non-spammy cold email subject line citing their business name and local market\"\n    ),\n    emailBody: z.string().describe(\n      \"Personalized, conversational cold outreach hook citing their exact grid rank stats and mentioning specific competitors eating their local market share\"\n    ),\n    smsOrVoicemailScript: z.string().describe(\n      \"A quick 30-second follow-up voice note or SMS script for multi-touch prospecting\"\n    ),\n  }),\n});\n\nexport type LocalSeoAuditPitchOutput = z.infer<typeof LocalSeoAuditPitchSchema>;\n```\n\n#### 2. Gemini Prompt Template\n\n```typescript\nexport function buildLocalSeoAuditPrompt(input: LocalSeoAuditPitchInput): string {\n  const compList = input.topCompetitorsInWeakZones\n    .map(\n      (c, i) =>\n        `   ${i + 1}. \"${c.name}\" - ${c.category || \'Competitor\'} (${c.reviews ?? \'N/A\'} reviews, ${c.rating ?? \'N/A\'}\342\230\205)`\n    )\n    .join(\'\\n\');\n\n  return `\nYou are a Principal Local SEO Specialist and Agency Prospecting Strategist analyzing an automated Geo-Grid local rank scan (similar to Local Falcon and ProfitMaps AI).\n\nTARGET BUSINESS PROFILE:\n- Business Name: \"${input.businessName}\"\n- Industry / Category: \"${input.category}\"\n- Target Location / Market: \"${input.metrics.targetMarket || \'Metro Area\'}\"\n\nGEO-GRID RANK TRACKING METRICS:\n- Total Scanned Grid Pins: ${input.metrics.totalNodesScanned} coordinates\n- Grid Radius / Coverage: ${input.metrics.gridSpanDescription || \'Local Service Radius\'}\n- Average Rank Position: ${input.metrics.averageRank.toFixed(1)} across the service area\n- Google 3-Pack Presence: ${input.metrics.top3Percentage.toFixed(1)}% of nodes in Top 3\n- Dropoff / Red Zone Coverage: ${(100 - input.metrics.top3Percentage).toFixed(1)}% of scanned territory is ranking at #4 or worse\n\nDOMINANT COMPETITORS CAPTURING WEAK/RED ZONES:\n${compList}\n\nINSTRUCTIONS:\n1. Conduct an incisive, data-backed Local SEO Geo-Grid Audit focusing on proximity bias, centroid drift, and pack displacement.\n2. Formulate a realistic, quantified missed revenue estimate: according to local search studies, Google\'s 3-Pack monopolizes ~70% of calls and direction requests. When a business drops past position 3, call volume drops off a cliff.\n3. Provide 4 crisp tactical action steps addressing GBP categories, NAP citations, review velocity/geo-keywords, and localized service-area landing pages.\n4. Craft an authentic, consultative cold email outreach pitch that an SEO agency can send to the owner of \"${input.businessName}\". It MUST weave in the exact grid metrics and cite specific competitor names to make it personalized and compelling.\n\nRespond strictly in valid JSON matching the schema.\n`.trim();\n}\n```\n\n#### 3. Sample JSON Output\n\n```json\n{\n  \"executiveSummary\": \"Geo-grid spatial analysis reveals significant centroid lock-in for Austin Premier Plumbing: rank drops from position #2 within 0.8 km to position #14 beyond 2.0 km. Across 25 scanned grid nodes, 84% fall into the red/yellow zone, allowing Apex Emergency Plumbing and Capital City Water Heaters to capture the majority of high-intent emergency plumbing searches.\",\n  \"missedRevenueEstimate\": \"Google Maps Local Pack (Top 3) commands 72% of mobile call clicks for emergency plumbing queries. With an overall average rank of 11.4 and only 16.0% 3-Pack presence, the business loses an estimated 55 to 70 direct calls monthly, translating to an estimated $22,000 - $35,000 in monthly missed dispatch revenue.\",\n  \"actionPlan\": {\n    \"gbpCategories\": \"Refine Google Business Profile categories by setting \'Plumber\' as primary and adding \'Drainage Service\', \'Water Heater Repair Service\', and \'Emergency Plumbing Service\' as secondary classifications.\",\n    \"citations\": \"Standardize NAP across core data aggregators and build 15 hyper-local Austin business citations (Austin Chamber, local neighborhood directories) to reinforce centroid expansion.\",\n    \"reviews\": \"Launch an automated post-job review request system encouraging verified customers to mention specific Austin zip codes and emergency services in review text.\",\n    \"onPageLocalizedContent\": \"Publish dedicated neighborhood landing pages (e.g. South Congress, Barton Hills, Mueller) with LocalBusiness GeoCoordinates JSON-LD schemas connected directly to the GBP CID.\"\n  },\n  \"coldOutreachPitch\": {\n    \"subjectLine\": \"Austin Premier Plumbing: Google Maps 25-pin grid audit\",\n    \"emailBody\": \"Hi team,\\n\\nI generated a 25-pin local geo-grid scan for emergency plumbing searches in Austin, and noticed something interesting about Austin Premier Plumbing\'s Google Maps reach.\\n\\nWhile you rank in the top 3 right next to your dispatch shop, your visibility drops to an average of #11.4 just two miles away\342\200\224meaning Apex Emergency Plumbing and Capital City Water Heaters are getting 84% of the incoming calls in your surrounding service territory.\\n\\nI have the complete color-coded geo-grid map ready. Can I send the PDF over so you can see where your calls are dropping off?\\n\\nBest,\\nMarcus Vance\",\n    \"smsOrVoicemailScript\": \"Hey team at Austin Premier Plumbing, Marcus here. Ran a quick 25-pin Google Maps radar audit across Austin\342\200\224you guys drop off after 1.5 miles while Apex Plumbing dominates the rest. Want me to send over the map screenshot?\"\n  }\n}\n```\n\n---\n\n### Included Interactive Prototype & Verification\n\n1. **Live Visual Geo-Grid Map**: Visual 3\303\2273, 5\303\2275, 7\303\2277 radar canvas rendering live coordinate offsets, bounding boxes, distance rings, and cardinal bearings.\n2. **SERP Parser Sandbox**: Interactive tester for Place ID, business name fuzzy matching, and domain resolution against a 20-item local SERP array.\n3. **AI Prospecting Workbench**: Live form connected to `/api/generate-audit-pitch` using `gemini-3.8-flash` on the Express backend with structured outputs and 1-click clipboard export.\n4. **Automated Unit Test Suite**: 10 tests verifying point count, symmetry, cardinal bearings, Haversine tolerances, rank tagging, competitor filtering, and Zod schema validation (accessible via `/api/engine-tests` and the interactive in-app test runner)."
    thinking: "**Verifying JSON Response**\n\nI\'ve confirmed the API delivers a pristine, validated JSON object that strictly adheres to the `LocalSeoAuditPitchSchema`. My focus now shifts to ensuring the generated JSON perfectly satisfies *every* requirement from the prompt. This involves meticulously re-evaluating each constraint against the output.\n\n\n**Constructing Core Functionality**\n\nI\'ve successfully created the geodesic grid generator, which calculates precise lat/long offsets, and the SERP rank parser with its status coloring. Both modules are fully implemented and tested. I\'m now developing the Local SEO AI Audit and Pitch Generator, with a Gemini prompt and a structured Zod schema.\n\n\n"
    modified_response: "Here is the complete, tested core engine architecture for your Local SEO Geo-Grid Rank Tracker and Prospecting SaaS prototype (comparable to ProfitMaps AI and Local Falcon).\n\n---\n\n### Item 1: Geodesic Coordinate Grid Generator (`src/engine/geoGrid.ts`)\n\nImplements exact geodesic math with meridional convergence scaling ($\\cos(\\phi)$ adjustment for longitude spacing) and Haversine distance/bearing calculations suitable for high-accuracy local ranking radii (0.1 km to 50+ km).\n\n```typescript\n/**\n * Local SEO Geo-Grid Coordinate Generator\n * Calculates an equidistant N x N matrix of geographic coordinates centered\n * around a target business or latitude/longitude location.\n */\n\nexport type DistanceUnit = \'km\' | \'mi\';\n\nexport interface GeoCoordinate {\n  lat: number;\n  lng: number;\n}\n\nexport interface GridGeneratorConfig {\n  /** Center coordinate (e.g. Google Business Profile latitude & longitude) */\n  center: GeoCoordinate;\n  /** Grid dimension: odd integer like 3, 5, 7, 9 (e.g. 5 yields a 5x5 grid of 25 nodes) */\n  gridSize: number;\n  /** Distance step between adjacent pins (e.g. 1.0 km or 0.5 mi) */\n  distanceStep: number;\n  /** Unit of distance: \'km\' (default) or \'mi\' */\n  unit?: DistanceUnit;\n}\n\nexport interface GridPoint {\n  id: string;\n  rowIndex: number; // 0 (North-most) to gridSize - 1 (South-most)\n  colIndex: number; // 0 (West-most) to gridSize - 1 (East-most)\n  lat: number;\n  lng: number;\n  offsetNorth: number; // Positive = North, Negative = South\n  offsetEast: number;  // Positive = East, Negative = West\n  distanceFromCenter: number; // True geodesic distance from center\n  bearingFromCenterDegrees: number; // 0\302\260 = North, 90\302\260 = East, 180\302\260 = South, 270\302\260 = West\n  isCenter: boolean;\n  unit: DistanceUnit;\n}\n\nexport interface GridResult {\n  center: GeoCoordinate;\n  gridSize: number;\n  totalPoints: number;\n  distanceStep: number;\n  unit: DistanceUnit;\n  points: GridPoint[];\n  bounds: {\n    north: number;\n    south: number;\n    east: number;\n    west: number;\n  };\n}\n\n/** Earth radius in kilometers and miles (WGS-84 / IUGG) */\nexport const EARTH_RADIUS = {\n  km: 6371.0088,\n  mi: 3958.7613,\n} as const;\n\nexport function toRadians(degrees: number): number {\n  return (degrees * Math.PI) / 180;\n}\n\nexport function toDegrees(radians: number): number {\n  return (radians * 180) / Math.PI;\n}\n\n/**\n * Calculates exact great-circle distance between two points using the Haversine formula.\n */\nexport function haversineDistance(\n  coord1: GeoCoordinate,\n  coord2: GeoCoordinate,\n  unit: DistanceUnit = \'km\'\n): number {\n  const R = EARTH_RADIUS[unit];\n  const dLat = toRadians(coord2.lat - coord1.lat);\n  const dLng = toRadians(coord2.lng - coord1.lng);\n  const lat1 = toRadians(coord1.lat);\n  const lat2 = toRadians(coord2.lat);\n\n  const a =\n    Math.sin(dLat / 2) * Math.sin(dLat / 2) +\n    Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) * Math.sin(dLng / 2);\n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n\n  return R * c;\n}\n\n/**\n * Calculates initial bearing from coord1 to coord2 in degrees (0\302\260..360\302\260).\n */\nexport function calculateBearing(coord1: GeoCoordinate, coord2: GeoCoordinate): number {\n  const lat1 = toRadians(coord1.lat);\n  const lat2 = toRadians(coord2.lat);\n  const dLng = toRadians(coord2.lng - coord1.lng);\n\n  const y = Math.sin(dLng) * Math.cos(lat2);\n  const x =\n    Math.cos(lat1) * Math.sin(lat2) -\n    Math.sin(lat1) * Math.cos(lat2) * Math.cos(dLng);\n\n  const brng = toDegrees(Math.atan2(y, x));\n  return (brng + 360) % 360;\n}\n\n/**\n * Generates an N x N coordinate grid for local maps rank tracking.\n */\nexport function generateGeoGrid(config: GridGeneratorConfig): GridResult {\n  const { center, gridSize, distanceStep, unit = \'km\' } = config;\n\n  if (gridSize < 1 || !Number.isInteger(gridSize)) {\n    throw new Error(`Grid size must be a positive integer, received: ${gridSize}`);\n  }\n  if (distanceStep <= 0) {\n    throw new Error(`Distance step must be greater than 0, received: ${distanceStep}`);\n  }\n  if (center.lat < -90 || center.lat > 90) {\n    throw new Error(`Center latitude out of bounds (-90 to 90): ${center.lat}`);\n  }\n  if (center.lng < -180 || center.lng > 180) {\n    throw new Error(`Center longitude out of bounds (-180 to 180): ${center.lng}`);\n  }\n\n  const R = EARTH_RADIUS[unit];\n  const centerRow = (gridSize - 1) / 2;\n  const centerCol = (gridSize - 1) / 2;\n\n  const points: GridPoint[] = [];\n  let maxLat = -Infinity;\n  let minLat = Infinity;\n  let maxLng = -Infinity;\n  let minLng = Infinity;\n\n  for (let r = 0; r < gridSize; r++) {\n    // Row 0 is North (+), row N-1 is South (-)\n    const deltaY = (centerRow - r) * distanceStep;\n\n    // Angular distance North/South in radians\n    const deltaLatRad = deltaY / R;\n    const pointLat = center.lat + toDegrees(deltaLatRad);\n\n    // Meridional convergence adjustment at mean latitude\n    const avgLatRad = toRadians((center.lat + pointLat) / 2);\n    const cosLat = Math.cos(avgLatRad);\n    const safeCosLat = Math.abs(cosLat) < 1e-6 ? 1e-6 : cosLat;\n\n    for (let c = 0; c < gridSize; c++) {\n      // Col 0 is West (-), col N-1 is East (+)\n      const deltaX = (c - centerCol) * distanceStep;\n\n      // Angular distance East/West in radians scaled for latitude\n      const deltaLngRad = deltaX / (R * safeCosLat);\n      const pointLng = center.lng + toDegrees(deltaLngRad);\n\n      const pointCoord: GeoCoordinate = {\n        lat: Number(pointLat.toFixed(6)),\n        lng: Number(pointLng.toFixed(6)),\n      };\n\n      const isCenter = r === centerRow && c === centerCol;\n      const trueDistance = isCenter ? 0 : haversineDistance(center, pointCoord, unit);\n      const bearing = isCenter ? 0 : calculateBearing(center, pointCoord);\n\n      maxLat = Math.max(maxLat, pointCoord.lat);\n      minLat = Math.min(minLat, pointCoord.lat);\n      maxLng = Math.max(maxLng, pointCoord.lng);\n      minLng = Math.min(minLng, pointCoord.lng);\n\n      points.push({\n        id: `node_r${r}_c${c}`,\n        rowIndex: r,\n        colIndex: c,\n        lat: pointCoord.lat,\n        lng: pointCoord.lng,\n        offsetNorth: Number(deltaY.toFixed(4)),\n        offsetEast: Number(deltaX.toFixed(4)),\n        distanceFromCenter: Number(trueDistance.toFixed(3)),\n        bearingFromCenterDegrees: Number(bearing.toFixed(1)),\n        isCenter,\n        unit,\n      });\n    }\n  }\n\n  return {\n    center,\n    gridSize,\n    totalPoints: points.length,\n    distanceStep,\n    unit,\n    points,\n    bounds: {\n      north: Number(maxLat.toFixed(6)),\n      south: Number(minLat.toFixed(6)),\n      east: Number(maxLng.toFixed(6)),\n      west: Number(minLng.toFixed(6)),\n    },\n  };\n}\n```\n\n---\n\n### Item 2: DataForSEO / Google Local SERP Rank Parser (`src/engine/serpParser.ts`)\n\nHandles Place ID matching, domain/URL matching (stripping subpaths and protocols), and fuzzy corporate name matching (stripping suffixes like LLC, Inc, Corp). Extracts target rank, color tag (`green` for 1-3, `yellow` for 4-10, `red` for 11+ / unranked), and the top 3 dominant competitors excluding the target business.\n\n```typescript\n/**\n * DataForSEO / SERP API Google Local Maps Rank Parser\n */\n\nexport interface SerpLocalItem {\n  rank_position: number;\n  name: string;\n  place_id?: string;\n  cid?: string;\n  address?: string;\n  rating?: number;\n  reviews?: number;\n  reviews_count?: number;\n  url?: string;\n  domain?: string;\n  phone?: string;\n  category?: string;\n  latitude?: number;\n  longitude?: number;\n}\n\nexport interface TargetBusinessIdentifier {\n  placeId?: string;\n  businessName?: string;\n  domainOrUrl?: string;\n}\n\nexport type RankStatusColor = \'green\' | \'yellow\' | \'red\';\n\nexport interface PinScanResult {\n  targetFound: boolean;\n  rank: number | null; // 1-20 or null if >20\n  rankDisplay: string; // \"1\", \"2\", ... \"20\", or \">20\"\n  statusColor: RankStatusColor; // \'green\' (1-3), \'yellow\' (4-10), \'red\' (11+ / unranked)\n  matchedBy: \'place_id\' | \'domain\' | \'business_name\' | \'none\';\n  matchedBusiness: SerpLocalItem | null;\n  topCompetitors: SerpLocalItem[]; // Top 3 dominant competitors excluding target\n  totalResultsScanned: number;\n  scannedAt: string;\n}\n\nexport function normalizeDomain(rawUrlOrDomain?: string): string {\n  if (!rawUrlOrDomain) return \'\';\n  let str = rawUrlOrDomain.trim().toLowerCase();\n  str = str.replace(/^(https?:\\/\\/)/i, \'\').replace(/^www\\./i, \'\');\n  const slashIdx = str.indexOf(\'/\');\n  if (slashIdx !== -1) str = str.substring(0, slashIdx);\n  const queryIdx = str.indexOf(\'?\');\n  if (queryIdx !== -1) str = str.substring(0, queryIdx);\n  return str.trim();\n}\n\nexport function normalizeBusinessName(name?: string): string {\n  if (!name) return \'\';\n  let str = name.toLowerCase().trim();\n  str = str.replace(/[&+,-]/g, \' \');\n  str = str.replace(/[^a-z0-9\\s]/g, \'\');\n  str = str.replace(/\\b(llc|inc|incorporated|corp|corporation|co|company|ltd|limited|services|group)\\b/g, \'\');\n  return str.replace(/\\s+/g, \' \').trim();\n}\n\nexport function isNameMatch(targetName: string, candidateName: string): boolean {\n  const normTarget = normalizeBusinessName(targetName);\n  const normCandidate = normalizeBusinessName(candidateName);\n\n  if (!normTarget || !normCandidate) return false;\n  if (normTarget === normCandidate) return true;\n\n  if (normTarget.length >= 4 && (normCandidate.includes(normTarget) || normTarget.includes(normCandidate))) {\n    return true;\n  }\n\n  const targetTokens = normTarget.split(\' \').filter((t) => t.length > 2);\n  const candidateTokens = new Set(normCandidate.split(\' \').filter((t) => t.length > 2));\n  if (targetTokens.length === 0) return false;\n\n  const matchCount = targetTokens.filter((token) => candidateTokens.has(token)).length;\n  return matchCount / targetTokens.length >= 0.75;\n}\n\nexport function parseLocalSerpRank(\n  target: TargetBusinessIdentifier,\n  serpItems: SerpLocalItem[]\n): PinScanResult {\n  const items = [...serpItems].sort((a, b) => a.rank_position - b.rank_position);\n\n  let matchedIndex = -1;\n  let matchMethod: \'place_id\' | \'domain\' | \'business_name\' | \'none\' = \'none\';\n\n  const cleanTargetPlaceId = target.placeId?.trim();\n  const cleanTargetDomain = normalizeDomain(target.domainOrUrl);\n  const cleanTargetName = target.businessName?.trim();\n\n  for (let i = 0; i < items.length; i++) {\n    const item = items[i];\n\n    // Priority 1: Exact Place ID\n    if (cleanTargetPlaceId && item.place_id && item.place_id.trim() === cleanTargetPlaceId) {\n      matchedIndex = i;\n      matchMethod = \'place_id\';\n      break;\n    }\n\n    // Priority 2: Domain / URL match\n    if (cleanTargetDomain) {\n      const itemDomain = normalizeDomain(item.domain || item.url);\n      if (itemDomain && (itemDomain === cleanTargetDomain || itemDomain.endsWith(`.${cleanTargetDomain}`) || cleanTargetDomain.endsWith(`.${itemDomain}`))) {\n        matchedIndex = i;\n        matchMethod = \'domain\';\n        break;\n      }\n    }\n\n    // Priority 3: Fuzzy business name\n    if (cleanTargetName && isNameMatch(cleanTargetName, item.name)) {\n      matchedIndex = i;\n      matchMethod = \'business_name\';\n      break;\n    }\n  }\n\n  const targetFound = matchedIndex !== -1;\n  const matchedItem = targetFound ? items[matchedIndex] : null;\n  const rank = matchedItem ? matchedItem.rank_position : null;\n\n  let statusColor: RankStatusColor = \'red\';\n  let rankDisplay = \'>20\';\n\n  if (rank !== null) {\n    rankDisplay = String(rank);\n    if (rank >= 1 && rank <= 3) statusColor = \'green\';\n    else if (rank >= 4 && rank <= 10) statusColor = \'yellow\';\n    else statusColor = \'red\';\n  }\n\n  // Top 3 competing businesses (excluding target business)\n  const competitors = items\n    .filter((_, idx) => idx !== matchedIndex)\n    .slice(0, 3);\n\n  return {\n    targetFound,\n    rank,\n    rankDisplay,\n    statusColor,\n    matchedBy: matchMethod,\n    matchedBusiness: matchedItem,\n    topCompetitors: competitors,\n    totalResultsScanned: items.length,\n    scannedAt: new Date().toISOString(),\n  };\n}\n```\n\n---\n\n### Item 3: Local SEO AI Audit & Pitch Generator\n\n#### 1. Zod Schema (`src/engine/aiAuditPitch.ts`)\n\n```typescript\nimport { z } from \'zod\';\n\nexport const LocalSeoAuditPitchSchema = z.object({\n  executiveSummary: z.string().describe(\n    \"High-impact summary of their visibility loss across the local geo-grid and proximity-dropoff analysis\"\n  ),\n  missedRevenueEstimate: z.string().describe(\n    \"Quantified economic breakdown explaining why being pushed out of the Google 3-Pack costs 70%+ of incoming phone calls and high-intent local customer volume\"\n  ),\n  actionPlan: z.object({\n    gbpCategories: z.string().describe(\n      \"Primary & secondary Google Business Profile (GBP) category optimization and service catalogue adjustments\"\n    ),\n    citations: z.string().describe(\n      \"NAP consistency cleanup, hyper-local structured data, and local directory citation velocity\"\n    ),\n    reviews: z.string().describe(\n      \"Geo-targeted review acquisition velocity, customer keyword integration, and review response signals\"\n    ),\n    onPageLocalizedContent: z.string().describe(\n      \"Localized landing pages, city/neighborhood service area content, and LocalBusiness schema markup\"\n    ),\n  }),\n  coldOutreachPitch: z.object({\n    subjectLine: z.string().describe(\n      \"Punchy, non-spammy cold email subject line citing their business name and local market\"\n    ),\n    emailBody: z.string().describe(\n      \"Personalized, conversational cold outreach hook citing their exact grid rank stats and mentioning specific competitors eating their local market share\"\n    ),\n    smsOrVoicemailScript: z.string().describe(\n      \"A quick 30-second follow-up voice note or SMS script for multi-touch prospecting\"\n    ),\n  }),\n});\n\nexport type LocalSeoAuditPitchOutput = z.infer<typeof LocalSeoAuditPitchSchema>;\n```\n\n#### 2. Gemini Prompt Template\n\n```typescript\nexport function buildLocalSeoAuditPrompt(input: LocalSeoAuditPitchInput): string {\n  const compList = input.topCompetitorsInWeakZones\n    .map(\n      (c, i) =>\n        `   ${i + 1}. \"${c.name}\" - ${c.category || \'Competitor\'} (${c.reviews ?? \'N/A\'} reviews, ${c.rating ?? \'N/A\'}\342\230\205)`\n    )\n    .join(\'\\n\');\n\n  return `\nYou are a Principal Local SEO Specialist and Agency Prospecting Strategist analyzing an automated Geo-Grid local rank scan (similar to Local Falcon and ProfitMaps AI).\n\nTARGET BUSINESS PROFILE:\n- Business Name: \"${input.businessName}\"\n- Industry / Category: \"${input.category}\"\n- Target Location / Market: \"${input.metrics.targetMarket || \'Metro Area\'}\"\n\nGEO-GRID RANK TRACKING METRICS:\n- Total Scanned Grid Pins: ${input.metrics.totalNodesScanned} coordinates\n- Grid Radius / Coverage: ${input.metrics.gridSpanDescription || \'Local Service Radius\'}\n- Average Rank Position: ${input.metrics.averageRank.toFixed(1)} across the service area\n- Google 3-Pack Presence: ${input.metrics.top3Percentage.toFixed(1)}% of nodes in Top 3\n- Dropoff / Red Zone Coverage: ${(100 - input.metrics.top3Percentage).toFixed(1)}% of scanned territory is ranking at #4 or worse\n\nDOMINANT COMPETITORS CAPTURING WEAK/RED ZONES:\n${compList}\n\nINSTRUCTIONS:\n1. Conduct an incisive, data-backed Local SEO Geo-Grid Audit focusing on proximity bias, centroid drift, and pack displacement.\n2. Formulate a realistic, quantified missed revenue estimate: according to local search studies, Google\'s 3-Pack monopolizes ~70% of calls and direction requests. When a business drops past position 3, call volume drops off a cliff.\n3. Provide 4 crisp tactical action steps addressing GBP categories, NAP citations, review velocity/geo-keywords, and localized service-area landing pages.\n4. Craft an authentic, consultative cold email outreach pitch that an SEO agency can send to the owner of \"${input.businessName}\". It MUST weave in the exact grid metrics and cite specific competitor names to make it personalized and compelling.\n\nRespond strictly in valid JSON matching the schema.\n`.trim();\n}\n```\n\n#### 3. Sample JSON Output\n\n```json\n{\n  \"executiveSummary\": \"Geo-grid spatial analysis reveals significant centroid lock-in for Austin Premier Plumbing: rank drops from position #2 within 0.8 km to position #14 beyond 2.0 km. Across 25 scanned grid nodes, 84% fall into the red/yellow zone, allowing Apex Emergency Plumbing and Capital City Water Heaters to capture the majority of high-intent emergency plumbing searches.\",\n  \"missedRevenueEstimate\": \"Google Maps Local Pack (Top 3) commands 72% of mobile call clicks for emergency plumbing queries. With an overall average rank of 11.4 and only 16.0% 3-Pack presence, the business loses an estimated 55 to 70 direct calls monthly, translating to an estimated $22,000 - $35,000 in monthly missed dispatch revenue.\",\n  \"actionPlan\": {\n    \"gbpCategories\": \"Refine Google Business Profile categories by setting \'Plumber\' as primary and adding \'Drainage Service\', \'Water Heater Repair Service\', and \'Emergency Plumbing Service\' as secondary classifications.\",\n    \"citations\": \"Standardize NAP across core data aggregators and build 15 hyper-local Austin business citations (Austin Chamber, local neighborhood directories) to reinforce centroid expansion.\",\n    \"reviews\": \"Launch an automated post-job review request system encouraging verified customers to mention specific Austin zip codes and emergency services in review text.\",\n    \"onPageLocalizedContent\": \"Publish dedicated neighborhood landing pages (e.g. South Congress, Barton Hills, Mueller) with LocalBusiness GeoCoordinates JSON-LD schemas connected directly to the GBP CID.\"\n  },\n  \"coldOutreachPitch\": {\n    \"subjectLine\": \"Austin Premier Plumbing: Google Maps 25-pin grid audit\",\n    \"emailBody\": \"Hi team,\\n\\nI generated a 25-pin local geo-grid scan for emergency plumbing searches in Austin, and noticed something interesting about Austin Premier Plumbing\'s Google Maps reach.\\n\\nWhile you rank in the top 3 right next to your dispatch shop, your visibility drops to an average of #11.4 just two miles away\342\200\224meaning Apex Emergency Plumbing and Capital City Water Heaters are getting 84% of the incoming calls in your surrounding service territory.\\n\\nI have the complete color-coded geo-grid map ready. Can I send the PDF over so you can see where your calls are dropping off?\\n\\nBest,\\nMarcus Vance\",\n    \"smsOrVoicemailScript\": \"Hey team at Austin Premier Plumbing, Marcus here. Ran a quick 25-pin Google Maps radar audit across Austin\342\200\224you guys drop off after 1.5 miles while Apex Plumbing dominates the rest. Want me to send over the map screenshot?\"\n  }\n}\n```\n\n---\n\n### Included Interactive Prototype & Verification\n\n1. **Live Visual Geo-Grid Map**: Visual 3\303\2273, 5\303\2275, 7\303\2277 radar canvas rendering live coordinate offsets, bounding boxes, distance rings, and cardinal bearings.\n2. **SERP Parser Sandbox**: Interactive tester for Place ID, business name fuzzy matching, and domain resolution against a 20-item local SERP array.\n3. **AI Prospecting Workbench**: Live form connected to `/api/generate-audit-pitch` using `gemini-3.8-flash` on the Express backend with structured outputs and 1-click clipboard export.\n4. **Automated Unit Test Suite**: 10 tests verifying point count, symmetry, cardinal bearings, Haversine tolerances, rank tagging, competitor filtering, and Zod schema validation (accessible via `/api/engine-tests` and the interactive in-app test runner)."
