  code_action {
    action_spec {
      create_file {
        instruction: "import express, { Request, Response } from \'express\';\nimport dotenv from \'dotenv\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport {\n  LocalSeoAuditPitchSchema,\n  geminiAuditPitchResponseSchema,\n  buildLocalSeoAuditPrompt,\n  generateDeterministicAuditPitch,\n  type LocalSeoAuditPitchInput,\n} from \'./src/engine/aiAuditPitch.ts\';\nimport { runAllEngineTests } from \'./src/engine/engineTests.ts\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst PORT = Number(process.env.PORT) || 3000;\n\napp.use(express.json());\n\n// Initialize Gemini Client with mandatory telemetry User-Agent\nconst geminiApiKey = process.env.GEMINI_API_KEY;\nlet aiClient: GoogleGenAI | null = null;\nif (geminiApiKey) {\n  aiClient = new GoogleGenAI({\n    apiKey: geminiApiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\n/**\n * Health & Engine Verification API\n */\napp.get(\'/api/health\', (_req: Request, res: Response) => {\n  res.json({\n    status: \'ok\',\n    hasGeminiKey: Boolean(geminiApiKey),\n    timestamp: new Date().toISOString(),\n  });\n});\n\n/**\n * Automated Engine Tests Execution API\n */\napp.get(\'/api/engine-tests\', (_req: Request, res: Response) => {\n  try {\n    const testResults = runAllEngineTests();\n    res.json(testResults);\n  } catch (error) {\n    res.status(500).json({\n      error: error instanceof Error ? error.message : \'Failed running tests\',\n    });\n  }\n});\n\n/**\n * Gemini-Powered Local SEO Audit & Prospecting Pitch Generation\n */\napp.post(\'/api/generate-audit-pitch\', async (req: Request, res: Response) => {\n  try {\n    const input: LocalSeoAuditPitchInput = req.body;\n\n    if (!input || !input.businessName || !input.category) {\n      res.status(400).json({\n        error: \'Missing required parameters: businessName and category are mandatory.\',\n      });\n      return;\n    }\n\n    // Default metrics if partial\n    const metrics = {\n      averageRank: input.metrics?.averageRank ?? 11.4,\n      top3Percentage: input.metrics?.top3Percentage ?? 16.0,\n      totalNodesScanned: input.metrics?.totalNodesScanned ?? 25,\n      gridSpanDescription: input.metrics?.gridSpanDescription ?? \'5x5 grid across 5.0 km radius\',\n      targetMarket: input.metrics?.targetMarket ?? \'Local Metro Area\',\n    };\n\n    const sanitizedInput: LocalSeoAuditPitchInput = {\n      businessName: input.businessName,\n      category: input.category,\n      metrics,\n      topCompetitorsInWeakZones: input.topCompetitorsInWeakZones || [],\n    };\n\n    // If Gemini client is available, call Gemini 3.8 Flash with structured schema\n    if (aiClient) {\n      try {\n        const prompt = buildLocalSeoAuditPrompt(sanitizedInput);\n        const response = await aiClient.models.generateContent({\n          model: \'gemini-3.8-flash\',\n          contents: prompt,\n          config: {\n            systemInstruction:\n              \'You are a high-level Local SEO Auditor and Prospecting Strategist. Analyze local geo-grid rank metrics and output precise, data-grounded audit reports and cold outreach pitches strictly conforming to the requested JSON schema.\',\n            responseMimeType: \'application/json\',\n            responseSchema: geminiAuditPitchResponseSchema,\n          },\n        });\n\n        const textOutput = response.text?.trim();\n        if (textOutput) {\n          const parsed = JSON.parse(textOutput);\n          const validated = LocalSeoAuditPitchSchema.safeParse(parsed);\n          if (validated.success) {\n            res.json({\n              success: true,\n              source: \'gemini-3.8-flash\',\n              data: validated.data,\n            });\n            return;\n          }\n        }\n      } catch (geminiError) {\n        console.warn(\'Gemini API call failed or timed out, falling back to deterministic engine:\', geminiError);\n      }\n    }\n\n    // High-fidelity fallback engine matching schema\n    const fallbackOutput = generateDeterministicAuditPitch(sanitizedInput);\n    res.json({\n      success: true,\n      source: \'deterministic-engine\',\n      data: fallbackOutput,\n      note: aiClient ? \'Fallback triggered due to upstream response\' : \'Generated using local deterministic engine (GEMINI_API_KEY not configured)\',\n    });\n  } catch (err) {\n    console.error(\'Audit generation error:\', err);\n    res.status(500).json({\n      error: err instanceof Error ? err.message : \'Internal Server Error\',\n    });\n  }\n});\n\n// Vite middleware mounting for SPA dev server\nasync function startServer() {\n  const isProduction = process.env.NODE_ENV === \'production\';\n\n  if (!isProduction) {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\n    app.get(\'*\', (_req: Request, res: Response) => {\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`GeoRank Pro engine server running at http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
