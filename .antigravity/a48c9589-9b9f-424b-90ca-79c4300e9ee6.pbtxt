              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      reviews: `Establish an automated SMS review generation flow asking recent customers to mention specific suburbs, neighborhoods, and service keywords (e.g., \'fast water heater replacement in South Congress\') to inject natural geo-relevance into your profile.`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
