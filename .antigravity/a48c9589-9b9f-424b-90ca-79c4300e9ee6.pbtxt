    combined_output {
      full: "{\"success\":true,\"source\":\"deterministic-engine\",\"data\":{\"executiveSummary\":\"Our 25-point geo-grid rank audit for Austin Premier Plumbing indicates severe geographic signal decay outside your immediate 0.5-mile centroid. While your business maintains visibility directly on your street, 84% of the scanned service area places you at position #11 or worse. High-margin searchers just 1.5 miles away are routed almost exclusively to Apex Emergency Plumbing and Capital City Water Heaters.\",\"missedRevenueEstimate\":\"In local search, positions 1 through 3 in the Google Local Pack capture between 68% and 74% of all high-intent phone calls and direction requests. With only 16.0% of your service grid ranking in the 3-Pack, you are forfeiting approximately 45 to 60 inbound quote opportunities per month in your category (Emergency Plumber), representing an estimated $18,000 - $32,000 in monthly gross billings diverted straight to nearby competitors.\",\"actionPlan\":{\"gbpCategories\":\"Audit primary and secondary GBP categories: Ensure your primary category precisely matches \\\"Emergency Plumber\\\" and add 3 to 5 targeted sub-categories (e.g., Emergency Services, Repair Specialists) rather than generic business labels.\",\"citations\":\"Fix name, address, and phone (NAP) discrepancies across top tier aggregators (Data Axle, Localeze, Foursquare) and sync high-relevance niche and hyper-local Austin business registries to strengthen geographic entity validation.\",\"reviews\":\"Establish an automated SMS review generation flow asking recent customers to mention specific suburbs, neighborhoods, and service keywords (e.g., \'fast water heater replacement in South Congress\') to inject natural geo-relevance into your profile.\",\"onPageLocalizedContent\":\"Deploy dedicated suburb landing pages on your website featuring embedded Google Maps, local geo-coordinates, client case studies, and schema.org/LocalBusiness structured markup linked back to your GBP CID.\"},\"coldOutreachPitch\":{\"subjectLine\":\"Quick question regarding Austin Premier Plumbing\'s Google Maps reach in Austin, TX\",\"emailBody\":\"Hi team at Austin Premier Plumbing,\\n\\nI was running a geo-grid visibility audit for emergency plumber providers in Austin, TX and pulled up your live Google Maps rank radius.\\n\\nRight outside your immediate office, your ranking drops from the top 3 down to an average of #11.4 across 84% of your nearby service territory. \\n\\nEssentially, homeowners searching for emergency plumber just 1.5 miles out are being routed to Apex Emergency Plumbing and Capital City Water Heaters simply because your proximity signals are constrained to your primary address.\\n\\nI compiled a visual 25-pin geo-map showing exactly where you are losing calls and the 4 fixes to reclaim the 3-pack across the full radius.\\n\\nWould it be okay if I forwarded the screenshot over? No obligation either way.\\n\\nBest regards,\\nLocal Growth Engineering Team\",\"smsOrVoicemailScript\":\"Hey Austin Premier Plumbing, this is Alex. I just ran a 25-pin geo-grid scan on Google Maps for Emergency Plumber in our area. You\'re crushing it within 2 blocks, but beyond 1 mile Apex Emergency Plumbing is taking 70% of the phone calls. I have a 1-page visual map showing the breakdown\342\200\224mind if I text or email it over?\"}},\"note\":\"Fallback triggered due to upstream response\"}"
    }
    command_line: "curl -s -X POST http://localhost:3000/api/generate-audit-pitch -H \"Content-Type: application/json\" -d \'{\"businessName\":\"Austin Premier Plumbing\",\"category\":\"Emergency Plumber\",\"metrics\":{\"averageRank\":11.4,\"top3Percentage\":16.0,\"totalNodesScanned\":25,\"targetMarket\":\"Austin, TX\"},\"topCompetitorsInWeakZones\":[{\"name\":\"Apex Emergency Plumbing\",\"rating\":4.9,\"reviews\":342},{\"name\":\"Capital City Water Heaters\",\"rating\":4.8,\"reviews\":215}]}\'"
