            }
            lines {
              text: "INSTRUCTIONS:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. Conduct an incisive, data-backed Local SEO Geo-Grid Audit focusing on proximity bias, centroid drift, and pack displacement."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
